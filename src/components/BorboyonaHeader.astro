---
// Header Institucional Exclusivo para Mina Polimetálica Borboyona & Tocllano
---

<header
  id="borboyona-navbar"
  class="fixed top-0 left-0 right-0 z-50 bg-slate-950/90 backdrop-blur-md border-b border-slate-800/80 transition-all duration-300"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand & Asset Identifier (Mantiene el logo institucional intacto) -->
      <a href="/" class="flex items-center gap-3 group shrink-0">
        <img
          src="/assets/sonde_logo_transparent.png"
          alt="Sonde Capital"
          class="h-9 sm:h-10 w-auto object-contain transition-transform duration-300 group-hover:scale-105"
        />
        <div class="flex flex-col border-l border-slate-800 pl-2.5 sm:pl-3">
          <span class="text-[10px] sm:text-xs tracking-widest text-slate-400 font-semibold uppercase leading-tight">
            Private Equity
          </span>
          <span class="text-[9px] sm:text-[10px] tracking-wider text-amber-400 font-extrabold uppercase leading-tight">
            Borboyona
          </span>
        </div>
      </a>

      <!-- Desktop Section Links (Navegación directa a cada sección técnica) -->
      <nav class="hidden lg:flex items-center gap-6 xl:gap-8 text-xs font-semibold text-slate-300">
        <a
          href="#tesoro"
          class="hover:text-amber-400 transition-colors py-1 relative after:absolute after:bottom-0 after:left-0 after:w-0 hover:after:w-full after:h-0.5 after:bg-amber-500 after:transition-all"
        >
          Estructura 6 km
        </a>
        <a
          href="#altitud"
          class="hover:text-amber-400 transition-colors py-1 relative after:absolute after:bottom-0 after:left-0 after:w-0 hover:after:w-full after:h-0.5 after:bg-amber-500 after:transition-all"
        >
          Socavones
        </a>
        <a
          href="#minerales"
          class="hover:text-amber-400 transition-colors py-1 relative after:absolute after:bottom-0 after:left-0 after:w-0 hover:after:w-full after:h-0.5 after:bg-amber-500 after:transition-all"
        >
          Minerales Críticos
        </a>
        <a
          href="#benchmarking"
          class="hover:text-amber-400 transition-colors py-1 relative after:absolute after:bottom-0 after:left-0 after:w-0 hover:after:w-full after:h-0.5 after:bg-amber-500 after:transition-all"
        >
          Stanford / Antamina
        </a>
        <a
          href="#logistica"
          class="hover:text-amber-400 transition-colors py-1 relative after:absolute after:bottom-0 after:left-0 after:w-0 hover:after:w-full after:h-0.5 after:bg-amber-500 after:transition-all"
        >
          Megapuerto Chancay
        </a>
        <a
          href="#garantias"
          class="hover:text-amber-400 transition-colors py-1 relative after:absolute after:bottom-0 after:left-0 after:w-0 hover:after:w-full after:h-0.5 after:bg-amber-500 after:transition-all"
        >
          Garantías Legales
        </a>
      </nav>

      <!-- Action Area: Único CTA con animación en Loop + Toggle Móvil -->
      <div class="flex items-center gap-3">
        <a
          href="#contacto"
          class="header-agenda-cta inline-flex items-center gap-2 bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-700 text-slate-950 font-extrabold px-3.5 sm:px-5 py-2 sm:py-2.5 rounded-xl text-xs sm:text-sm tracking-wide transition-all shadow-md shadow-amber-500/20 active:scale-95 relative overflow-hidden shrink-0 cursor-pointer"
        >
          <i class="fa-solid fa-calendar-check text-xs relative z-10"></i>
          <span class="relative z-10 whitespace-nowrap">Agendar Reunión</span>
        </a>

        <!-- Mobile Menu Toggle Button -->
        <button
          id="borboyona-mobile-btn"
          type="button"
          class="lg:hidden text-slate-300 hover:text-amber-400 p-2 rounded-xl border border-slate-800 bg-slate-900/80 focus:outline-none transition-colors"
          aria-label="Abrir menú de navegación"
        >
          <i id="borboyona-menu-icon" class="fa-solid fa-bars text-base"></i>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div
    id="borboyona-mobile-menu"
    class="hidden lg:hidden bg-slate-950/98 border-b border-slate-800 px-5 pt-3 pb-6 space-y-3 transition-all backdrop-blur-xl"
  >
    <a
      href="#tesoro"
      class="mobile-nav-link block py-2 text-sm font-semibold text-slate-300 hover:text-amber-400 border-b border-slate-900 transition-colors"
    >
      <i class="fa-solid fa-gem text-amber-400 text-xs mr-2"></i> Estructura «El Tesoro» 6 km
    </a>
    <a
      href="#altitud"
      class="mobile-nav-link block py-2 text-sm font-semibold text-slate-300 hover:text-amber-400 border-b border-slate-900 transition-colors"
    >
      <i class="fa-solid fa-mountain text-amber-400 text-xs mr-2"></i> Socavones &amp; Muestreos
    </a>
    <a
      href="#minerales"
      class="mobile-nav-link block py-2 text-sm font-semibold text-slate-300 hover:text-amber-400 border-b border-slate-900 transition-colors"
    >
      <i class="fa-solid fa-atom text-amber-400 text-xs mr-2"></i> Matriz Minerales Críticos
    </a>
    <a
      href="#benchmarking"
      class="mobile-nav-link block py-2 text-sm font-semibold text-slate-300 hover:text-amber-400 border-b border-slate-900 transition-colors"
    >
      <i class="fa-solid fa-graduation-cap text-amber-400 text-xs mr-2"></i> Stanford (Dr. Marco Einaudi)
    </a>
    <a
      href="#logistica"
      class="mobile-nav-link block py-2 text-sm font-semibold text-slate-300 hover:text-amber-400 border-b border-slate-900 transition-colors"
    >
      <i class="fa-solid fa-route text-amber-400 text-xs mr-2"></i> Megapuerto de Chancay
    </a>
    <a
      href="#garantias"
      class="mobile-nav-link block py-2 text-sm font-semibold text-slate-300 hover:text-amber-400 border-b border-slate-900 transition-colors"
    >
      <i class="fa-solid fa-scale-balanced text-amber-400 text-xs mr-2"></i> Seguridad Jurídica &amp; Ticrapo
    </a>
    <div class="pt-2">
      <a
        href="#contacto"
        class="mobile-nav-link w-full inline-flex justify-center items-center gap-2 bg-gradient-to-r from-amber-500 to-amber-600 text-slate-950 font-extrabold py-3 px-4 rounded-xl text-xs uppercase tracking-wider"
      >
        <i class="fa-solid fa-calendar-check text-xs"></i>
        <span>Agendar Reunión</span>
      </a>
    </div>
  </div>
</header>

<script is:inline>
  const mobileBtn = document.getElementById('borboyona-mobile-btn');
  const mobileMenu = document.getElementById('borboyona-mobile-menu');
  const menuIcon = document.getElementById('borboyona-menu-icon');
  const navLinks = document.querySelectorAll('.mobile-nav-link');

  if (mobileBtn && mobileMenu && menuIcon) {
    mobileBtn.addEventListener('click', () => {
      const isHidden = mobileMenu.classList.contains('hidden');
      if (isHidden) {
        mobileMenu.classList.remove('hidden');
        menuIcon.className = 'fa-solid fa-xmark text-base';
      } else {
        mobileMenu.classList.add('hidden');
        menuIcon.className = 'fa-solid fa-bars text-base';
      }
    });

    // Close menu when tapping any anchor link
    navLinks.forEach((link) => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        menuIcon.className = 'fa-solid fa-bars text-base';
      });
    });
  }
</script>

<style>
  /* Attention-Grabbing Looping Animation for Header Agendar Reunión CTA */
  .header-agenda-cta {
    animation: headerCtaPulse 3s ease-in-out infinite;
    will-change: transform, box-shadow;
  }

  .header-agenda-cta::after {
    content: '';
    position: absolute;
    top: -50%;
    left: -60%;
    width: 50%;
    height: 200%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.45),
      transparent
    );
    transform: rotate(25deg);
    animation: headerCtaSweep 3.2s cubic-bezier(0.4, 0, 0.2, 1) infinite 0.5s;
    pointer-events-none;
  }

  @keyframes headerCtaPulse {
    0%, 100% {
      transform: scale(1);
      box-shadow: 0 4px 14px 0 rgba(245, 158, 11, 0.3), 0 0 0 0 rgba(245, 158, 11, 0.35);
    }
    50% {
      transform: scale(1.03);
      box-shadow: 0 8px 24px 0 rgba(245, 158, 11, 0.55), 0 0 0 6px rgba(245, 158, 11, 0.15);
    }
  }

  @keyframes headerCtaSweep {
    0%, 25% {
      left: -60%;
    }
    70%, 100% {
      left: 150%;
    }
  }

  .header-agenda-cta:active {
    transform: scale(0.97) !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .header-agenda-cta,
    .header-agenda-cta::after {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>
