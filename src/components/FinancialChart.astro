---
interface Props {
  chartId?: string;
  title?: string;
  subtitle?: string;
}

const {
  chartId = "sondeFinancialChart",
  title = "Proyección de Flujo de Retorno Acumulado (USD)",
  subtitle = "Escenario Base con Tasa Interna de Retorno (TIR) proyectada del 42.8%"
} = Astro.props;
---

<div class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200/90 shadow-sm transition-all hover:border-slate-300">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-4 border-b border-slate-100">
    <div>
      <div class="flex items-center gap-2 mb-1">
        <span class="inline-block w-2.5 h-2.5 rounded-full bg-amber-500"></span>
        <h3 class="text-lg font-bold text-slate-900">{title}</h3>
      </div>
      <p class="text-xs text-slate-500">{subtitle}</p>
    </div>

    <!-- Toggle metrics buttons -->
    <div class="flex items-center gap-2 bg-slate-100 p-1 rounded-lg self-start sm:self-auto">
      <button
        type="button"
        id={`${chartId}-btn-cumulative`}
        class="px-3 py-1.5 text-xs font-semibold rounded-md bg-white text-slate-900 shadow-xs transition-all"
        data-view="cumulative"
      >
        Flujo Acumulado
      </button>
      <button
        type="button"
        id={`${chartId}-btn-ebitda`}
        class="px-3 py-1.5 text-xs font-semibold rounded-md text-slate-600 hover:text-slate-900 transition-all"
        data-view="ebitda"
      >
        EBITDA Anual
      </button>
    </div>
  </div>

  <!-- Chart Canvas Container -->
  <div class="relative w-full h-[320px] sm:h-[380px]">
    <canvas id={chartId}></canvas>
  </div>

  <!-- Legend & Key Metrics Footer -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-6 pt-4 border-t border-slate-100">
    <div class="bg-slate-50 p-3 rounded-xl">
      <span class="text-[11px] uppercase tracking-wider text-slate-500 font-semibold block">Inversión Fase 1</span>
      <span class="text-base sm:text-lg font-bold text-slate-900 tabular-nums">$3.5M USD</span>
    </div>
    <div class="bg-slate-50 p-3 rounded-xl">
      <span class="text-[11px] uppercase tracking-wider text-slate-500 font-semibold block">Payback Estimado</span>
      <span class="text-base sm:text-lg font-bold text-amber-600 tabular-nums">1.8 Años</span>
    </div>
    <div class="bg-slate-50 p-3 rounded-xl">
      <span class="text-[11px] uppercase tracking-wider text-slate-500 font-semibold block">VAN (10% Dcto)</span>
      <span class="text-base sm:text-lg font-bold text-slate-900 tabular-nums">$18.4M USD</span>
    </div>
    <div class="bg-slate-50 p-3 rounded-xl">
      <span class="text-[11px] uppercase tracking-wider text-slate-500 font-semibold block">TIR Estimada</span>
      <span class="text-base sm:text-lg font-bold text-emerald-600 tabular-nums">42.8%</span>
    </div>
  </div>
</div>

<script is:inline src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script is:inline define:vars={{ chartId }}>
  document.addEventListener('DOMContentLoaded', () => {
    const ctx = document.getElementById(chartId);
    if (!ctx) return;

    const labels = ['Año 1 (Capex)', 'Año 2', 'Año 3', 'Año 4', 'Año 5', 'Año 6'];
    
    const cumulativeData = [-3.5, 2.4, 7.8, 14.1, 20.6, 26.5];
    const ebitdaData = [-3.5, 5.9, 5.4, 6.3, 6.5, 5.9];

    let currentMode = 'cumulative';

    const chart = new Chart(ctx, {
      type: 'line',
      data: {
        labels: labels,
        datasets: [{
          label: 'Flujo Acumulado Neto ($M USD)',
          data: cumulativeData,
          borderColor: '#d97706', // Gold / Amber
          backgroundColor: 'rgba(245, 158, 11, 0.08)',
          fill: true,
          tension: 0.35,
          borderWidth: 3,
          pointBackgroundColor: '#d97706',
          pointBorderColor: '#ffffff',
          pointBorderWidth: 2,
          pointRadius: 5,
          pointHoverRadius: 7
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            display: false
          },
          tooltip: {
            backgroundColor: '#0f172a',
            titleColor: '#ffffff',
            bodyColor: '#f8fafc',
            borderColor: '#334155',
            borderWidth: 1,
            padding: 12,
            displayColors: false,
            callbacks: {
              label: function(context) {
                return `${context.dataset.label}: $${context.parsed.y}M USD`;
              }
            }
          }
        },
        scales: {
          x: {
            grid: {
              color: 'rgba(15, 23, 42, 0.04)'
            },
            ticks: {
              color: '#64748b',
              font: {
                family: 'Inter',
                size: 11
              }
            }
          },
          y: {
            grid: {
              color: 'rgba(15, 23, 42, 0.06)'
            },
            ticks: {
              color: '#64748b',
              font: {
                family: 'Inter',
                size: 11
              },
              callback: function(value) {
                return '$' + value + 'M';
              }
            }
          }
        }
      }
    });

    const btnCum = document.getElementById(`${chartId}-btn-cumulative`);
    const btnEbitda = document.getElementById(`${chartId}-btn-ebitda`);

    if (btnCum && btnEbitda) {
      btnCum.addEventListener('click', () => {
        if (currentMode === 'cumulative') return;
        currentMode = 'cumulative';
        btnCum.className = 'px-3 py-1.5 text-xs font-semibold rounded-md bg-white text-slate-900 shadow-xs transition-all';
        btnEbitda.className = 'px-3 py-1.5 text-xs font-semibold rounded-md text-slate-600 hover:text-slate-900 transition-all';
        chart.data.datasets[0].label = 'Flujo Acumulado Neto ($M USD)';
        chart.data.datasets[0].data = cumulativeData;
        chart.data.datasets[0].borderColor = '#d97706';
        chart.data.datasets[0].backgroundColor = 'rgba(245, 158, 11, 0.08)';
        chart.update();
      });

      btnEbitda.addEventListener('click', () => {
        if (currentMode === 'ebitda') return;
        currentMode = 'ebitda';
        btnEbitda.className = 'px-3 py-1.5 text-xs font-semibold rounded-md bg-white text-slate-900 shadow-xs transition-all';
        btnCum.className = 'px-3 py-1.5 text-xs font-semibold rounded-md text-slate-600 hover:text-slate-900 transition-all';
        chart.data.datasets[0].label = 'EBITDA Proyectado ($M USD)';
        chart.data.datasets[0].data = ebitdaData;
        chart.data.datasets[0].borderColor = '#0f172a';
        chart.data.datasets[0].backgroundColor = 'rgba(15, 23, 42, 0.05)';
        chart.update();
      });
    }
  });
</script>
