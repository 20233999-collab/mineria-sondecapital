---
interface SlideItem {
  id: string;
  badge: string;
  title: string;
  subtitle: string;
  category: string;
}

interface Props {
  projectTitle: string;
  projectCode: string;
  slides: SlideItem[];
  dossierPdfUrl?: string;
}

const {
  projectTitle,
  projectCode,
  slides,
  dossierPdfUrl = "/assets/resumen-ejecutivo-borboyona (1).pdf"
} = Astro.props;
---

<div class="presentation-viewer bg-slate-900 text-slate-100 min-h-screen flex flex-col selection:bg-amber-500 selection:text-white" id="presentationContainer">
  <!-- Top Presentation Toolbar -->
  <header class="h-16 px-4 sm:px-8 border-b border-slate-800 bg-slate-950/90 backdrop-blur-md flex items-center justify-between z-40 sticky top-0">
    <div class="flex items-center gap-4">
      <a
        href="/"
        class="flex items-center gap-2 text-xs font-semibold text-slate-400 hover:text-white px-3 py-1.5 rounded-lg bg-slate-800/80 hover:bg-slate-800 transition-colors border border-slate-700/60"
        title="Volver a Inicio"
      >
        <i class="fa-solid fa-arrow-left text-[11px] text-amber-400"></i>
        <span>Sonde Capital</span>
      </a>

      <div class="h-5 w-px bg-slate-800 hidden sm:block"></div>

      <div class="flex items-center gap-2">
        <span class="px-2 py-0.5 rounded text-[10px] font-extrabold uppercase bg-amber-500/20 text-amber-400 border border-amber-500/30">
          {projectCode}
        </span>
        <h1 class="text-sm sm:text-base font-bold text-white tracking-tight truncate max-w-[200px] sm:max-w-md">
          {projectTitle}
        </h1>
      </div>
    </div>

    <!-- Presentation Controls & Actions -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Slide Counter Indicator -->
      <div class="hidden sm:flex items-center gap-1 text-xs font-semibold text-slate-400 bg-slate-900 px-3 py-1.5 rounded-lg border border-slate-800 tabular-nums">
        <span>Diapositiva</span>
        <span class="text-amber-400 font-bold" id="currentSlideNumber">1</span>
        <span>/</span>
        <span id="totalSlidesNumber">{slides.length}</span>
      </div>

      <!-- Fullscreen Toggle -->
      <button
        type="button"
        id="btnFullscreen"
        class="p-2 text-slate-400 hover:text-white rounded-lg bg-slate-800/60 hover:bg-slate-800 transition-colors border border-slate-700/60 text-xs"
        title="Pantalla Completa (F)"
      >
        <i class="fa-solid fa-expand"></i>
      </button>

      <!-- Download Dossier PDF -->
      <a
        href={dossierPdfUrl}
        download
        class="inline-flex items-center gap-2 bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-700 text-slate-950 px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all shadow-xs"
        title="Descargar Dossier Ejecutivo"
      >
        <i class="fa-solid fa-file-pdf"></i>
        <span class="hidden md:inline">Descargar Ficha PDF</span>
      </a>
    </div>
  </header>

  <!-- Slide Progression Tabs -->
  <nav class="bg-slate-950/70 border-b border-slate-800/80 px-4 sm:px-8 py-2 overflow-x-auto">
    <div class="flex items-center gap-2 min-w-max">
      {slides.map((s, idx) => (
        <button
          type="button"
          class={`slide-tab-btn flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-semibold transition-all border ${
            idx === 0
              ? "bg-amber-500/10 text-amber-300 border-amber-500/40 shadow-xs"
              : "bg-transparent text-slate-400 border-transparent hover:bg-slate-900 hover:text-slate-200"
          }`}
          data-slide-index={idx}
        >
          <span class="w-4 h-4 rounded-full bg-slate-800 text-amber-400 text-[10px] flex items-center justify-center font-bold">
            {idx + 1}
          </span>
          <span>{s.title}</span>
        </button>
      ))}
    </div>
  </nav>

  <!-- Presentation Stage (Main View Area) -->
  <main class="flex-grow flex items-center justify-center p-4 sm:p-8 lg:p-12 relative overflow-hidden bg-slate-950">
    <!-- Ambient Glow Texture Background -->
    <div class="absolute inset-0 pointer-events-none opacity-20">
      <div class="absolute top-1/4 left-1/3 w-96 h-96 bg-amber-500/20 rounded-full blur-3xl"></div>
      <div class="absolute bottom-1/4 right-1/3 w-96 h-96 bg-blue-600/20 rounded-full blur-3xl"></div>
    </div>

    <!-- Active Slide Host Container -->
    <div class="w-full max-w-6xl relative z-10">
      <slot />
    </div>
  </main>

  <!-- Bottom Interactive Presentation Bar (Navigation Controls) -->
  <footer class="h-16 px-4 sm:px-8 bg-slate-950 border-t border-slate-800 flex items-center justify-between z-30">
    <div class="flex items-center gap-3">
      <button
        type="button"
        id="btnPrevSlide"
        class="flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-300 hover:text-white font-semibold text-xs transition-all border border-slate-800 active:scale-95 disabled:opacity-40 disabled:cursor-not-allowed"
      >
        <i class="fa-solid fa-arrow-left"></i>
        <span class="hidden sm:inline">Anterior (←)</span>
      </button>

      <button
        type="button"
        id="btnNextSlide"
        class="flex items-center gap-2 px-5 py-2 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-700 text-slate-950 font-bold text-xs transition-all shadow-xs active:scale-95 disabled:opacity-40 disabled:cursor-not-allowed"
      >
        <span>Siguiente (→)</span>
        <i class="fa-solid fa-arrow-right"></i>
      </button>
    </div>

    <!-- Slide Timeline Indicators -->
    <div class="flex items-center gap-1.5">
      {slides.map((_, idx) => (
        <span
          class={`slide-indicator h-1.5 rounded-full transition-all duration-300 ${
            idx === 0 ? "w-8 bg-amber-500" : "w-2 bg-slate-800"
          }`}
          data-indicator-index={idx}
        ></span>
      ))}
    </div>

    <!-- Presentation Help / Quick Keys -->
    <div class="hidden lg:flex items-center gap-3 text-[11px] text-slate-500">
      <span class="flex items-center gap-1">
        <kbd class="px-1.5 py-0.5 bg-slate-900 border border-slate-800 rounded text-[10px] text-slate-400">←</kbd>
        <kbd class="px-1.5 py-0.5 bg-slate-900 border border-slate-800 rounded text-[10px] text-slate-400">→</kbd> Navegar
      </span>
      <span>•</span>
      <span class="flex items-center gap-1">
        <kbd class="px-1.5 py-0.5 bg-slate-900 border border-slate-800 rounded text-[10px] text-slate-400">F</kbd> Pantalla completa
      </span>
    </div>
  </footer>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    let currentSlide = 0;
    const slides = document.querySelectorAll('.slide-content-panel');
    const tabButtons = document.querySelectorAll('.slide-tab-btn');
    const indicators = document.querySelectorAll('.slide-indicator');
    const currentSlideNumEl = document.getElementById('currentSlideNumber');
    const totalSlidesNumEl = document.getElementById('totalSlidesNumber');
    const btnPrev = document.getElementById('btnPrevSlide');
    const btnNext = document.getElementById('btnNextSlide');
    const btnFullscreen = document.getElementById('btnFullscreen');
    const container = document.getElementById('presentationContainer');

    const total = slides.length;
    if (totalSlidesNumEl) totalSlidesNumEl.textContent = total;

    function goToSlide(index) {
      if (index < 0 || index >= total) return;
      currentSlide = index;

      // Update slide contents visibility
      slides.forEach((slide, i) => {
        if (i === currentSlide) {
          slide.classList.remove('hidden');
          slide.classList.add('flex');
        } else {
          slide.classList.add('hidden');
          slide.classList.remove('flex');
        }
      });

      // Update tabs style
      tabButtons.forEach((tab, i) => {
        if (i === currentSlide) {
          tab.className = 'slide-tab-btn flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-semibold transition-all border bg-amber-500/10 text-amber-300 border-amber-500/40 shadow-xs';
        } else {
          tab.className = 'slide-tab-btn flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-semibold transition-all border bg-transparent text-slate-400 border-transparent hover:bg-slate-900 hover:text-slate-200';
        }
      });

      // Update indicators
      indicators.forEach((ind, i) => {
        if (i === currentSlide) {
          ind.className = 'slide-indicator h-1.5 rounded-full transition-all duration-300 w-8 bg-amber-500';
        } else {
          ind.className = 'slide-indicator h-1.5 rounded-full transition-all duration-300 w-2 bg-slate-800';
        }
      });

      if (currentSlideNumEl) currentSlideNumEl.textContent = currentSlide + 1;

      if (btnPrev) btnPrev.disabled = currentSlide === 0;
      if (btnNext) {
        if (currentSlide === total - 1) {
          btnNext.innerHTML = '<span>Finalizar</span><i class="fa-solid fa-check ml-1"></i>';
        } else {
          btnNext.innerHTML = '<span>Siguiente (→)</span><i class="fa-solid fa-arrow-right"></i>';
        }
      }
    }

    // Initialize first slide
    goToSlide(0);

    // Button click listeners
    if (btnPrev) btnPrev.addEventListener('click', () => goToSlide(currentSlide - 1));
    if (btnNext) btnNext.addEventListener('click', () => goToSlide(currentSlide + 1));

    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = parseInt(btn.getAttribute('data-slide-index') || '0', 10);
        goToSlide(idx);
      });
    });

    // Keyboard navigation
    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'PageDown' || e.key === ' ') {
        e.preventDefault();
        goToSlide(currentSlide + 1);
      } else if (e.key === 'ArrowLeft' || e.key === 'PageUp') {
        e.preventDefault();
        goToSlide(currentSlide - 1);
      } else if (e.key === 'f' || e.key === 'F') {
        toggleFullscreen();
      }
    });

    function toggleFullscreen() {
      if (!document.fullscreenElement) {
        container?.requestFullscreen().catch(err => console.log(err));
      } else {
        document.exitFullscreen().catch(err => console.log(err));
      }
    }

    if (btnFullscreen) {
      btnFullscreen.addEventListener('click', toggleFullscreen);
    }
  });
</script>
