---
// Componente de Vías de Inversión y Proceso de Due Diligence
const timelinePhases = [
  {
    step: "01",
    title: "Expresión de Interés",
    time: "Semana 1",
    desc: "Recepción de carta de interés institucional (LOI) y calificación preliminar de la entidad solicitante."
  },
  {
    step: "02",
    title: "Formalización de NDA",
    time: "Semanas 1-2",
    desc: "Suscripción mutua de acuerdo de confidencialidad institucional para proteger la reserva técnica del activo."
  },
  {
    step: "03",
    title: "Acceso al Data Room",
    time: "Semanas 2-6",
    desc: "Apertura de los 15 estudios de laboratorio (ACTLABS, ALS, SGS), ensayos ICP-MS crudos y mapas geológicos satelitales."
  },
  {
    step: "04",
    title: "Presentación de Term Sheet",
    time: "Semanas 6-8",
    desc: "Estructuración de oferta no vinculante definiendo el modelo seleccionado (Adquisición, JV u Offtake)."
  },
  {
    step: "05",
    title: "Cierre & Transferencia",
    time: "Semanas 8-12",
    desc: "Formalización contractual, cierre notarial definitivo y registro de derechos mineros ante INGEMMET."
  }
];
---

<section id="estructuras" class="py-24 bg-white border-b border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16" data-animate="fade-up">
      <span class="text-xs uppercase font-extrabold tracking-widest text-amber-600 block mb-1">
        Modelos de Transacción Institucional
      </span>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-slate-950 font-['Plus_Jakarta_Sans'] tracking-tight">
        Vías de Inversión & Participación
      </h2>
      <p class="text-slate-600 text-sm sm:text-base mt-2">
        Sonde Capital ha estructurado tres alternativas de colaboración para adaptarse a los requerimientos de fondos soberanos, operadores mineros y procesadores químicos.
      </p>
    </div>

    <!-- 3 Investment Cards Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-20">
      <!-- Option 1: Full Acquisition -->
      <div
        data-animate="fade-up"
        data-delay="0"
        class="bg-slate-50 rounded-2xl p-8 border border-slate-200 hover:border-slate-300 hover:shadow-lg transition-all duration-300 flex flex-col justify-between"
      >
        <div>
          <div class="w-12 h-12 rounded-xl bg-slate-900 text-white flex items-center justify-center text-xl mb-6 shadow-sm">
            <i class="fa-solid fa-landmark"></i>
          </div>

          <span class="text-xs font-bold uppercase tracking-wider text-slate-500 block mb-1">
            Control Total del Activo
          </span>
          <h3 class="text-2xl font-extrabold text-slate-950 mb-2">
            Adquisición Completa
          </h3>
          <p class="text-amber-600 font-extrabold text-xl font-mono mb-4">
            USD $2,500,000,000+
          </p>

          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-6">
            Compra directa del 100% de las 05 concesiones mineras registradas, derechos de explotación, banco de datos geoquímicos y los 15 estudios certificados. Soberanía total sobre un depósito irrepetible en la cuenca del Pacífico.
          </p>
        </div>

        <div class="pt-4 border-t border-slate-200 text-xs text-slate-500 font-semibold flex items-center gap-2">
          <i class="fa-solid fa-users text-slate-400"></i>
          <span>Ideal para: Fondos Soberanos, Consorcios Globales</span>
        </div>
      </div>

      <!-- Option 2: Joint Venture (Recommended) -->
      <div
        data-animate="fade-up"
        data-delay="100"
        class="bg-slate-950 text-white rounded-2xl p-8 border-2 border-amber-500 shadow-xl hover:shadow-2xl transition-all duration-300 flex flex-col justify-between relative overflow-hidden group"
      >
        <!-- Recommended Badge -->
        <div class="absolute top-0 right-0 bg-gradient-to-r from-amber-500 to-amber-600 text-slate-950 text-[10px] font-extrabold uppercase tracking-widest px-3 py-1 rounded-bl-xl shadow-xs">
          Opción Recomendada
        </div>

        <div>
          <div class="w-12 h-12 rounded-xl bg-amber-500/20 border border-amber-500/40 text-amber-400 flex items-center justify-center text-xl mb-6 shadow-sm">
            <i class="fa-solid fa-handshake"></i>
          </div>

          <span class="text-xs font-bold uppercase tracking-wider text-amber-400 block mb-1">
            Alianza Estratégica Operativa
          </span>
          <h3 class="text-2xl font-extrabold text-white mb-2">
            Joint Venture & Operación
          </h3>
          <p class="text-amber-400 font-extrabold text-xl font-mono mb-4">
            Participación Negociada
          </p>

          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed mb-6">
            El operador cualificado aporta capital de desarrollo y capacidad de extracción minera a cambio de una participación accionaria en el proyecto o reparto proporcional de ingresos (*revenue share*). Sonde Capital acompaña la gobernanza institucional y social local.
          </p>
        </div>

        <div class="pt-4 border-t border-slate-800 text-xs text-slate-400 font-semibold flex items-center gap-2">
          <i class="fa-solid fa-helmet-safety text-amber-400"></i>
          <span>Ideal para: Mineras Mid-Tier, Firmas de PE Minero</span>
        </div>
      </div>

      <!-- Option 3: Raw Offtake Supply -->
      <div
        data-animate="fade-up"
        data-delay="200"
        class="bg-slate-50 rounded-2xl p-8 border border-slate-200 hover:border-slate-300 hover:shadow-lg transition-all duration-300 flex flex-col justify-between"
      >
        <div>
          <div class="w-12 h-12 rounded-xl bg-slate-900 text-white flex items-center justify-center text-xl mb-6 shadow-sm">
            <i class="fa-solid fa-boxes-packing"></i>
          </div>

          <span class="text-xs font-bold uppercase tracking-wider text-slate-500 block mb-1">
            Cadena de Suministro Directa
          </span>
          <h3 class="text-2xl font-extrabold text-slate-950 mb-2">
            Suministro de Mineral (Offtake)
          </h3>
          <p class="text-amber-600 font-extrabold text-xl font-mono mb-4">
            Contratos Ex Works (EXW)
          </p>

          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-6">
            Acuerdos de suministro continuado de mineral triturado en condiciones Ex Works para plantas de separación y refinación química en Norteamérica, Europa o Asia. La vía más rápida a abastecimiento garantizado sin adquisición patrimonial.
          </p>
        </div>

        <div class="pt-4 border-t border-slate-200 text-xs text-slate-500 font-semibold flex items-center gap-2">
          <i class="fa-solid fa-industry text-slate-400"></i>
          <span>Ideal para: Refinadores Químicos, Fabricantes de Imanes</span>
        </div>
      </div>
    </div>

    <!-- 5-Phase Process Timeline -->
    <div class="bg-slate-50 rounded-2xl p-8 sm:p-10 border border-slate-200" data-animate="fade-up">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <span class="text-xs font-extrabold uppercase tracking-widest text-slate-500 block mb-1">
          Hoja de Ruta de Transacción
        </span>
        <h3 class="text-xl sm:text-2xl font-extrabold text-slate-950">
          Cronograma de Formalización y Due Diligence
        </h3>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-5 gap-4 relative">
        {timelinePhases.map((phase) => (
          <div class="bg-white rounded-xl p-5 border border-slate-200 shadow-2xs relative group hover:border-amber-400 transition-colors">
            <div class="flex items-center justify-between mb-3">
              <span class="text-xl font-black font-mono text-amber-600">
                {phase.step}
              </span>
              <span class="text-[10px] font-bold uppercase px-2 py-0.5 rounded bg-slate-100 text-slate-600">
                {phase.time}
              </span>
            </div>
            <h4 class="font-bold text-slate-900 text-sm mb-1.5 leading-snug">
              {phase.title}
            </h4>
            <p class="text-xs text-slate-500 leading-relaxed">
              {phase.desc}
            </p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
