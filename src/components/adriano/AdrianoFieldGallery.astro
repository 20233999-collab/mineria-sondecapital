---
// Componente de Galería de Terreno & Evidencias del Proyecto
const galleryItems = [
  {
    image: "/assets/adriano/Tracto.jpg",
    title: "Operaciones y Accesibilidad de Superficie",
    description: "Equipos de exploración y maquinaria pesada operando en las concesiones del Proyecto Adriano. Evidencia de acceso 100% transitable a cielo abierto.",
    tag: "Terreno & Accesibilidad"
  },
  {
    image: "/assets/adriano/Foto Reunion Embajada de India.jpg",
    title: "Interés Diplomático & Soberano Internacional",
    description: "Sesión de trabajo de la alta dirección de Sonde Capital con la delegación diplomática y comercial de la Embajada de la India en Lima, abordando alianzas estratégicas de suministro de minerales críticos.",
    tag: "Tracción Bilateral"
  },
  {
    image: "/assets/adriano/Tracto 3.jpg",
    title: "Afloramiento del Macizo Gabroico",
    description: "Inspección de las formaciones ofiolíticas donde los 41 elementos estratégicos se encuentran diseminados directamente en superficie.",
    tag: "Geología en Terreno"
  },
  {
    image: "/assets/adriano/Tracto 4.jpg",
    title: "Corredor Logístico y Vías Internas",
    description: "Infraestructura vial consolidada que conecta el área de concesiones con la red troncal hacia el Puerto de Salaverry.",
    tag: "Infraestructura Vial"
  }
];
---

<section class="py-24 bg-slate-50 border-b border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16" data-animate="fade-up">
      <span class="text-xs uppercase font-extrabold tracking-widest text-amber-600 block mb-1">
        Evidencia Documental en Terreno
      </span>
      <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-950 font-['Plus_Jakarta_Sans']">
        Registro Fotográfico del Activo & Respaldos Institucionales
      </h2>
      <p class="text-slate-600 text-sm sm:text-base mt-2">
        Constancia visual de las concesiones, actividades de campo y reuniones de alto nivel con delegaciones soberanas interesadas en la seguridad de suministro.
      </p>
    </div>

    <!-- Gallery Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {galleryItems.map((item, idx) => (
        <div
          data-animate="fade-up"
          data-delay={idx * 100}
          class={`bg-white rounded-2xl overflow-hidden shadow-xs hover:shadow-xl transition-all duration-300 group flex flex-col ${idx === 1 ? 'diplomatic-card-loop border-2 border-amber-400/80 relative' : 'border border-slate-200'}`}
        >
          <!-- Image with zoom effect -->
          <div class="relative h-64 sm:h-72 w-full overflow-hidden bg-slate-900">
            <img
              src={item.image}
              alt={item.title}
              class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 ease-out"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>
            <span class={`absolute top-4 left-4 text-[10px] font-extrabold uppercase tracking-wider px-3 py-1 rounded-full border backdrop-blur-xs flex items-center gap-1.5 ${idx === 1 ? 'bg-amber-950/90 text-amber-300 border-amber-400/60 shadow-md' : 'bg-slate-900/90 text-amber-400 border-slate-700/80'}`}>
              {idx === 1 && (
                <span class="relative flex h-2 w-2 shrink-0">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-400"></span>
                </span>
              )}
              <span>{item.tag}</span>
            </span>
          </div>

          <!-- Description Box -->
          <div class="p-6 flex-grow flex flex-col justify-between">
            <div>
              <h3 class="text-lg font-bold text-slate-950 mb-2 group-hover:text-amber-600 transition-colors">
                {item.title}
              </h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                {item.description}
              </p>
            </div>

            <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-400">
              <span class="flex items-center gap-1.5">
                <i class="fa-solid fa-camera text-slate-400"></i>
                Archivo Confidencial Sonde Capital
              </span>
              <span class="text-amber-600 font-semibold text-[11px]">Validado</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* =========================================================================
     ANIMACIÓN EN LOOP CONTINUO PARA TARJETA DIPLOMÁTICA
     ========================================================================= */
  @keyframes diplomaticGlowPulse {
    0%, 100% {
      border-color: rgba(245, 158, 11, 0.5);
      box-shadow: 0 4px 20px -2px rgba(245, 158, 11, 0.15);
    }
    50% {
      border-color: rgba(251, 191, 36, 1);
      box-shadow: 0 8px 32px 2px rgba(245, 158, 11, 0.35), 0 0 16px 2px rgba(245, 158, 11, 0.2);
    }
  }

  .diplomatic-card-loop {
    animation: diplomaticGlowPulse 3.8s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .diplomatic-card-loop {
      animation: none !important;
    }
  }
</style>
