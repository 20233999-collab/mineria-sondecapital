---
// Componente Hero Institucional con fondo de terreno real nítido, animación escalonada y badge sirena
---

<section id="hero" class="relative min-h-[94vh] flex items-center justify-center pt-24 pb-20 overflow-hidden bg-slate-950 text-white">
  <!-- Real Deposit Background Image: High-res (2181x930) & Balanced Contrast -->
  <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
    <img
      src="/assets/adriano/Foto Portada.png"
      alt="Macizo Geológico del Proyecto Adriano"
      class="w-full h-full object-cover object-center scale-100 filter brightness-85 contrast-110"
      loading="eager"
    />
    <!-- Refined Gradient Overlays with Deep Financial Navy Blue Tint -->
    <div class="absolute inset-0 bg-gradient-to-b from-[#061224]/85 via-[#0B2144]/55 to-[#050E1C]/95"></div>
    <div class="absolute inset-0 bg-[#0F2D5C]/25 mix-blend-color pointer-events-none"></div>
    <div class="absolute inset-0 bg-radial from-[#0A2246]/45 via-transparent to-transparent"></div>
    <!-- Fine Grid Overlay -->
    <div
      class="absolute inset-0 opacity-[0.08] pointer-events-none"
      style="background-image: radial-gradient(#38BDF8 1px, transparent 1px); background-size: 36px 36px;"
    ></div>
  </div>

  <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <!-- 1. Confidentiality Badge -->
    <div
      data-animate="fade-up"
      data-delay="100"
      class="hero-badge-entrance inline-block mb-6"
    >
      <div class="siren-badge inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full border text-[11px] font-extrabold tracking-wider uppercase bg-transparent transition-all duration-300">
        <!-- Amber/Yellow Light Indicator -->
        <span class="relative flex h-2.5 w-2.5 shrink-0">
          <span class="siren-beacon-ping absolute inline-flex h-full w-full rounded-full opacity-75"></span>
          <span class="siren-beacon-dot relative inline-flex rounded-full h-2.5 w-2.5"></span>
        </span>
        <i class="fa-solid fa-shield-halved text-[11px]"></i>
        <span>Estrictamente Confidencial · Exclusivo para Inversionistas Calificados</span>
      </div>
    </div>

    <!-- 2. Display Main Heading: El Monstruo Polimetálico de los Andes -->
    <h1
      data-animate="fade-up"
      data-delay="200"
      class="hero-title-entrance text-3xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight leading-[1.12] mb-8 font-['Plus_Jakarta_Sans'] drop-shadow-md"
    >
      El Monstruo Polimetálico<br class="hidden sm:inline" />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-200 via-amber-400 to-amber-500">
        de los Andes
      </span>
    </h1>

    <!-- 3. Dual Primary Call to Actions (Cortos, Dinámicos y Llamativos con Animación en Loop) -->
    <div
      data-animate="fade-up"
      data-delay="350"
      class="hero-ctas-entrance flex flex-col sm:flex-row justify-center items-center gap-4 mb-12"
    >
      <!-- CTA Principal: Solicitar Data Room (Aura en loop + destello líquido continuo) -->
      <a
        href="#contacto"
        class="adriano-cta-primary-loop relative overflow-hidden w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 rounded-xl bg-gradient-to-r from-amber-500 via-amber-400 to-amber-500 text-slate-950 font-extrabold text-sm tracking-wide shadow-xl transition-all duration-300 hover:-translate-y-0.5 active:scale-95 border border-amber-300/80 group"
      >
        <!-- Destello líquido transversal continuo -->
        <span class="adriano-liquid-sheen absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-white/45 to-transparent skew-x-12 pointer-events-none"></span>
        <i class="fa-solid fa-file-shield text-xs transition-transform duration-300 group-hover:scale-110"></i>
        <span>Solicitar Data Room</span>
        <i class="fa-solid fa-arrow-right text-[11px] opacity-75 group-hover:translate-x-1 transition-transform"></i>
      </a>

      <!-- CTA Secundario: Explorar 41 Elementos -->
      <a
        href="#elementos"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-7 py-4 rounded-xl bg-slate-900/90 hover:bg-slate-800 text-slate-100 hover:text-white font-bold text-sm tracking-wide border border-slate-700/80 hover:border-amber-400/60 backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 active:scale-95 shadow-md group"
      >
        <i class="fa-solid fa-atom text-amber-400 text-xs transition-transform duration-300 group-hover:rotate-12"></i>
        <span>Explorar 41 Elementos</span>
      </a>
    </div>

    <!-- 4. Certified Labs & Validation Ribbon -->
    <div
      data-animate="fade-up"
      data-delay="500"
      class="hero-validation-entrance pt-7 border-t border-slate-800/90 flex flex-col md:flex-row items-center justify-center gap-5 text-xs text-slate-300"
    >
      <span class="uppercase tracking-wider font-extrabold text-slate-400 text-[10px]">
        Validación Analítica Independiente (15 Estudios · 2004–2022):
      </span>
      <div class="flex flex-wrap items-center justify-center gap-6 font-semibold text-slate-200">
        <span class="flex items-center gap-1.5">
          <i class="fa-solid fa-circle-check text-amber-400 text-[10px]"></i>
          ACTLABS (Canadá)
        </span>
        <span class="flex items-center gap-1.5">
          <i class="fa-solid fa-circle-check text-amber-400 text-[10px]"></i>
          ALS-Chemex (Vancouver)
        </span>
        <span class="flex items-center gap-1.5">
          <i class="fa-solid fa-circle-check text-amber-400 text-[10px]"></i>
          SGS del Perú
        </span>
        <span class="px-2.5 py-0.5 rounded-full bg-slate-800/90 border border-slate-700 text-amber-300 text-[11px] font-bold">
          Ensayos ICP-MS & LGR
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  /* =========================================================================
     ANIMACIONES DE ENTRADA (Skill: animation-on-scroll / animation-systems)
     ========================================================================= */
  @keyframes heroEntranceFadeUp {
    from {
      opacity: 0;
      transform: translateY(22px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-badge-entrance {
    animation: heroEntranceFadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.05s both;
  }

  .hero-title-entrance {
    animation: heroEntranceFadeUp 0.85s cubic-bezier(0.16, 1, 0.3, 1) 0.18s both;
  }

  .hero-ctas-entrance {
    animation: heroEntranceFadeUp 0.85s cubic-bezier(0.16, 1, 0.3, 1) 0.32s both;
  }

  .hero-validation-entrance {
    animation: heroEntranceFadeUp 0.85s cubic-bezier(0.16, 1, 0.3, 1) 0.46s both;
  }

  /* =========================================================================
     ANIMACIÓN EN LOOP CONTINUO PARA CTA PRIMARIO
     ========================================================================= */
  @keyframes adrianoCtaGlowPulse {
    0%, 100% {
      box-shadow: 0 4px 18px 0 rgba(245, 158, 11, 0.38), 0 0 10px 0 rgba(245, 158, 11, 0.15);
      border-color: rgba(251, 191, 36, 0.85);
    }
    50% {
      box-shadow: 0 8px 32px 4px rgba(245, 158, 11, 0.65), 0 0 22px 2px rgba(245, 158, 11, 0.35);
      border-color: rgba(255, 255, 255, 0.95);
      transform: translateY(-1px);
    }
  }

  @keyframes adrianoLiquidSheenLoop {
    0% {
      transform: translateX(-150%) skewX(-20deg);
    }
    30%, 100% {
      transform: translateX(250%) skewX(-20deg);
    }
  }

  .adriano-cta-primary-loop {
    animation: adrianoCtaGlowPulse 3.5s ease-in-out infinite;
  }

  .adriano-liquid-sheen {
    animation: adrianoLiquidSheenLoop 3.8s ease-in-out infinite;
  }

  /* =========================================================================
     YELLOW CONFIDENTIALITY BADGE
     ========================================================================= */
  @keyframes badge-gentle-amber-loop {
    0%, 100% {
      background-color: transparent;
      color: #FACC15;
      border-color: rgba(250, 204, 21, 0.75);
      box-shadow: 0 0 10px rgba(250, 204, 21, 0.15);
    }
    50% {
      background-color: transparent;
      color: #FDE047;
      border-color: rgba(253, 224, 71, 0.95);
      box-shadow: 0 0 18px rgba(250, 204, 21, 0.35);
    }
  }

  @keyframes beacon-amber-pulse {
    0%, 100% {
      transform: scale(0.95);
      opacity: 0.85;
    }
    50% {
      transform: scale(1.1);
      opacity: 1;
    }
  }

  .siren-badge {
    background-color: transparent !important;
    animation: badge-gentle-amber-loop 6.5s infinite ease-in-out;
  }

  .siren-beacon-dot {
    background-color: #FACC15;
    animation: beacon-amber-pulse 6.5s infinite ease-in-out;
  }

  .siren-beacon-ping {
    background-color: #FACC15;
    animation: ping 2.8s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-badge-entrance,
    .hero-title-entrance,
    .hero-ctas-entrance,
    .hero-validation-entrance,
    .adriano-cta-primary-loop,
    .adriano-liquid-sheen,
    .siren-badge,
    .siren-beacon-dot,
    .siren-beacon-ping {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>
