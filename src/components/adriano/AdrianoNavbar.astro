---
// Componente de navegación institucional Slim para Metales Estratégicos & Tierras Raras Adriano
---

<header
  id="adriano-navbar"
  class="fixed top-0 left-0 right-0 z-50 bg-white/90 backdrop-blur-md border-b border-slate-200/75 transition-all duration-300"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Branding / Logo -->
      <a href="/" class="flex items-center gap-2.5 group">
        <img
          src="/assets/sonde_logo_transparent.png"
          alt="Sonde Capital"
          class="h-8 w-auto object-contain transition-transform duration-300 group-hover:scale-105"
        />
        <div class="hidden sm:flex flex-col border-l border-slate-200 pl-2.5">
          <span class="text-[10px] font-extrabold uppercase tracking-widest text-slate-800 leading-none">
            Adriano
          </span>
          <span class="text-[9px] text-amber-600 font-semibold uppercase tracking-wider">
            Critical Metals
          </span>
        </div>
      </a>

      <!-- Slim Desktop Navigation -->
      <nav class="hidden md:flex items-center space-x-7 text-xs font-semibold text-slate-600">
        <a
          href="#resumen"
          class="hover:text-amber-600 transition-colors py-1 relative after:absolute after:bottom-0 after:left-0 after:w-0 hover:after:w-full after:h-0.5 after:bg-amber-500 after:transition-all"
        >
          Escala
        </a>
        <a
          href="#geopolitica"
          class="hover:text-amber-600 transition-colors py-1 relative after:absolute after:bottom-0 after:left-0 after:w-0 hover:after:w-full after:h-0.5 after:bg-amber-500 after:transition-all"
        >
          Contexto Geopolítico
        </a>
        <a
          href="#elementos"
          class="hover:text-amber-600 transition-colors py-1 relative after:absolute after:bottom-0 after:left-0 after:w-0 hover:after:w-full after:h-0.5 after:bg-amber-500 after:transition-all"
        >
          Matriz 41 Elementos
        </a>
        <a
          href="#geologia"
          class="hover:text-amber-600 transition-colors py-1 relative after:absolute after:bottom-0 after:left-0 after:w-0 hover:after:w-full after:h-0.5 after:bg-amber-500 after:transition-all"
        >
          Geología
        </a>
        <a
          href="#estructuras"
          class="hover:text-amber-600 transition-colors py-1 relative after:absolute after:bottom-0 after:left-0 after:w-0 hover:after:w-full after:h-0.5 after:bg-amber-500 after:transition-all"
        >
          Vías de Inversión
        </a>
      </nav>

      <!-- Primary Action CTA -->
      <div class="flex items-center gap-3">
        <a
          href="#contacto"
          class="inline-flex items-center gap-2 bg-slate-950 hover:bg-slate-800 text-white text-xs font-bold px-4 py-2 rounded-lg transition-all shadow-xs border border-slate-800 hover:border-amber-500/50 active:scale-95"
        >
          <i class="fa-solid fa-lock text-amber-400 text-[11px]"></i>
          <span>Solicitar NDA</span>
        </a>

        <!-- Mobile Menu Toggle Button -->
        <button
          id="mobile-menu-btn"
          type="button"
          class="md:hidden p-2 text-slate-600 hover:text-slate-950 rounded-lg hover:bg-slate-100 transition-colors"
          aria-label="Abrir menú"
        >
          <i class="fa-solid fa-bars text-sm"></i>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-slate-200 bg-white/98 backdrop-blur-lg px-4 py-4 space-y-2 text-sm font-semibold">
    <a href="#resumen" class="block py-2 text-slate-700 hover:text-amber-600 transition-colors">
      Escala
    </a>
    <a href="#geopolitica" class="block py-2 text-slate-700 hover:text-amber-600 transition-colors">
      Contexto Geopolítico
    </a>
    <a href="#elementos" class="block py-2 text-slate-700 hover:text-amber-600 transition-colors">
      Matriz 41 Elementos
    </a>
    <a href="#geologia" class="block py-2 text-slate-700 hover:text-amber-600 transition-colors">
      Geología
    </a>
    <a href="#estructuras" class="block py-2 text-slate-700 hover:text-amber-600 transition-colors">
      Vías de Inversión
    </a>
    <div class="pt-2 border-t border-slate-100">
      <a
        href="#contacto"
        class="flex items-center justify-center gap-2 w-full bg-slate-950 text-white py-2.5 rounded-lg text-xs font-bold shadow-xs"
      >
        <i class="fa-solid fa-lock text-amber-400 text-xs"></i>
        <span>Solicitar Credenciales & NDA</span>
      </a>
    </div>
  </div>
</header>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    if (btn && menu) {
      btn.addEventListener('click', () => {
        menu.classList.toggle('hidden');
      });
      menu.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => menu.classList.add('hidden'));
      });
    }

    // Shadow enhancement on scroll
    const navbar = document.getElementById('adriano-navbar');
    window.addEventListener('scroll', () => {
      if (window.scrollY > 20) {
        navbar?.classList.add('shadow-sm', 'bg-white/95');
      } else {
        navbar?.classList.remove('shadow-sm', 'bg-white/95');
      }
    });
  });
</script>
