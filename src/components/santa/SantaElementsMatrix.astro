      geopolitics: "Insumo crítico para materiales compuestos avanzados en aviación militar."
    }
  ];

  let currentCategory = 'all';
  let isExpanded = false;
  let currentSearch = '';

  const gridContainer = document.getElementById('elements-grid');
  const toggleBtn = document.getElementById('toggle-expand-btn');
  const toggleText = document.getElementById('toggle-expand-text');
  const toggleIcon = document.getElementById('toggle-expand-icon');
  const expandGradient = document.getElementById('expand-gradient');
  const expandSubtext = document.getElementById('expand-subtext');
  const searchInput = document.getElementById('element-search-input');
  const noElementsMsg = document.getElementById('no-elements-msg');

  // Modal elements
  const modal = document.getElementById('element-modal');
  const modalCloseBtn = document.getElementById('close-modal-btn');
  const modalOkBtn = document.getElementById('modal-ok-btn');
  const modalSymbol = document.getElementById('modal-symbol');
  const modalName = document.getElementById('modal-name');
  const modalCategory = document.getElementById('modal-category');
  const modalPpm1 = document.getElementById('modal-ppm1');
  const modalPpm2 = document.getElementById('modal-ppm2');
  const modalApplication = document.getElementById('modal-application');
  const modalGeopolitics = document.getElementById('modal-geopolitics');

  function openModal(el) {
    modalSymbol.innerText = el.symbol;
    modalName.innerText = el.name;
    modalCategory.innerText = el.categoryName;
    modalPpm1.innerText = el.ppm1;
    modalPpm2.innerText = el.ppm2;
    modalApplication.innerText = el.application;
    modalGeopolitics.innerText = el.geopolitics;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
  }

  function closeModal() {
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }

  if (modalCloseBtn) modalCloseBtn.addEventListener('click', closeModal);
  if (modalOkBtn) modalOkBtn.addEventListener('click', closeModal);
  modal.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  function renderElements() {
    gridContainer.innerHTML = '';

    const filtered = santaElements.filter(el => {
      const matchCat = (currentCategory === 'all') || (el.category === currentCategory);
      const matchSearch = currentSearch === '' || 
        el.name.toLowerCase().includes(currentSearch.toLowerCase()) || 
        el.symbol.toLowerCase().includes(currentSearch.toLowerCase()) ||
        el.application.toLowerCase().includes(currentSearch.toLowerCase());
      return matchCat && matchSearch;
    });

    if (filtered.length === 0) {
      noElementsMsg.classList.remove('hidden');
      document.getElementById('expand-controls').classList.add('hidden');
      return;
    } else {
      noElementsMsg.classList.add('hidden');
      document.getElementById('expand-controls').classList.remove('hidden');
    }

    const itemsToDisplay = isExpanded ? filtered : filtered.slice(0, 8);

    itemsToDisplay.forEach((el, index) => {
      const card = document.createElement('div');
      card.className = "bg-white rounded-2xl p-5 border border-slate-200 shadow-xs hover:shadow-lg hover:border-amber-500/80 transition-all duration-300 flex flex-col justify-between group cursor-pointer hover:-translate-y-1";
      
      card.innerHTML = `
        <div>
          <div class="flex items-start justify-between mb-2.5">
            <div class="flex items-center gap-2.5">
              <span class="text-2xl sm:text-3xl font-black font-mono text-slate-900 group-hover:text-amber-600 transition-colors">${el.symbol}</span>
              <div class="flex flex-col">
                <span class="text-xs font-bold text-slate-900 leading-tight">${el.name}</span>
                <span class="text-[10px] text-slate-400 font-mono">#${el.num}</span>
              </div>
            </div>
            <span class="text-[9px] font-extrabold uppercase tracking-wider px-2 py-0.5 rounded-full border ${el.badgeClass}">
              ${el.categoryName.split(' ')[0]}
            </span>
          </div>

          <div class="bg-slate-50 rounded-xl p-2.5 mb-3 border border-slate-100 flex items-center justify-between text-xs">
            <div>
              <span class="text-[9px] uppercase tracking-wider text-slate-400 block font-semibold">T-RARAS01</span>
              <span class="font-bold text-slate-950 font-mono text-xs">${el.ppm1}</span>
            </div>
            <div class="text-right">
              <span class="text-[9px] uppercase tracking-wider text-slate-400 block font-semibold">T-RARAS02</span>
              <span class="font-extrabold text-amber-600 font-mono text-xs">${el.ppm2}</span>
            </div>
          </div>

          <p class="text-xs text-slate-600 line-clamp-2 leading-relaxed">
            ${el.application}
          </p>
        </div>

        <div class="mt-4 pt-2.5 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-400 group-hover:text-amber-600 font-semibold transition-colors">
          <span>Ver ficha completa</span>
          <i class="fa-solid fa-arrow-right text-[10px] group-hover:translate-x-1 transition-transform"></i>
        </div>
      `;

      card.addEventListener('click', () => openModal(el));
      gridContainer.appendChild(card);
    });

    // Update expand controls text
    if (isExpanded || filtered.length <= 8) {
      expandGradient.classList.add('opacity-0');
      toggleText.innerText = "Mostrar menos";
      toggleIcon.classList.add('rotate-180');
      expandSubtext.innerText = `Mostrando todos los ${filtered.length} elementos`;
    } else {
      expandGradient.classList.remove('opacity-0');
      toggleText.innerText = `Ver todos los ${filtered.length} elementos`;
      toggleIcon.classList.remove('rotate-180');
      expandSubtext.innerText = `Mostrando las primeras 2 filas (8 de ${filtered.length} elementos certificados)`;
    }
  }

  // Filter Buttons Click Handling
  const filterBtns = document.querySelectorAll('.filter-btn');
  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => {
        b.classList.remove('active', 'bg-slate-950', 'text-white', 'shadow-xs');
        b.classList.add('bg-slate-100', 'text-slate-600');
      });
      btn.classList.add('active', 'bg-slate-950', 'text-white', 'shadow-xs');
      btn.classList.remove('bg-slate-100', 'text-slate-600');

      currentCategory = btn.getAttribute('data-category');
      renderElements();
    });
  });

  // Toggle Expand
  if (toggleBtn) {
    toggleBtn.addEventListener('click', () => {
      isExpanded = !isExpanded;
      renderElements();
    });
  }

  // Search Input
  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      currentSearch = e.target.value;
      renderElements();
    });
  }

  // Initial Render
  document.addEventListener('DOMContentLoaded', renderElements);
</script>
