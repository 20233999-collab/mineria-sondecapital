---
// Matriz Dinámica e Interactiva de los 32 Elementos Certificados por ALS (2026)
// Datos oficiales del Certificado ALS Perú S.A. LI26179573 (5-jun-2026)
---

<section id="elementos" class="py-20 sm:py-28 bg-slate-50 border-b border-slate-200 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header (Animación de entrada) -->
    <div data-animate="fade-up" data-delay="0" class="text-center max-w-3xl mx-auto mb-12">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-800 text-xs font-bold uppercase tracking-wider mb-4">
        <i class="fa-solid fa-flask-vial text-amber-600"></i>
        <span>Certificación Analítica ALS Perú S.A. (LI26179573)</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-slate-950 tracking-tight font-['Plus_Jakarta_Sans']">
        Matriz de los 32 Elementos & Metales Críticos
      </h2>
      <p class="text-xs sm:text-sm text-slate-600 mt-3 leading-relaxed">
        Análisis geoquímico oficial por fusión con borato de litio e ICP-MS (Muestras T-RARAS01 y T-RARAS02). Explore concentraciones certificadas y aplicaciones estratégicas en defensa y tecnología de punta.
      </p>
    </div>

    <!-- Search & Category Filters Bar (Animación de entrada) -->
    <div data-animate="fade-up" data-delay="150" class="bg-white rounded-2xl p-4 sm:p-5 shadow-sm border border-slate-200 mb-8 flex flex-col md:flex-row gap-4 items-center justify-between">
      
      <!-- Interactive Search Input -->
      <div class="relative w-full md:w-80">
        <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
        <input 
          id="element-search-input" 
          type="text" 
          placeholder="Buscar elemento (ej. Hafnio, Hf, Escandio)..."
          class="w-full pl-9 pr-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50 text-xs sm:text-sm font-medium focus:outline-none focus:ring-2 focus:ring-amber-500 focus:bg-white transition-all"
        />
      </div>

      <!-- Filter Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-2 w-full md:w-auto">
        <button type="button" class="filter-btn active px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all bg-slate-950 text-white shadow-xs" data-category="all">
          Todos (32)
        </button>
        <button type="button" class="filter-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold text-slate-600 bg-slate-100 hover:bg-slate-200 transition-all" data-category="hree">
          TTRR Pesadas (HREE)
        </button>
        <button type="button" class="filter-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold text-slate-600 bg-slate-100 hover:bg-slate-200 transition-all" data-category="lree">
          TTRR Ligeras (LREE)
        </button>
        <button type="button" class="filter-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold text-slate-600 bg-slate-100 hover:bg-slate-200 transition-all" data-category="critical">
          Metales Críticos
        </button>
        <button type="button" class="filter-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold text-slate-600 bg-slate-100 hover:bg-slate-200 transition-all" data-category="industrial">
          Industriales
        </button>
      </div>

    </div>

    <!-- Elements Grid Container -->
    <div id="elements-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-5 transition-all duration-300">
      
      <!-- Cards rendered client-side or populated below -->

    </div>

    <!-- Expand / Collapse Controls (Inicialmente 2 filas visibles) -->
    <div id="expand-controls" class="relative mt-8 text-center" data-animate="fade-up" data-delay="200">
      <!-- Gradient overlay when collapsed -->
      <div id="expand-gradient" class="absolute -top-32 left-0 right-0 h-32 bg-gradient-to-t from-slate-50 via-slate-50/85 to-transparent pointer-events-none transition-opacity duration-300 z-10"></div>
      
      <div class="relative z-20 pt-2 flex flex-col items-center justify-center gap-2">
        <button 
          id="toggle-expand-btn" 
          type="button" 
          class="expand-btn-loop relative overflow-hidden inline-flex items-center gap-3 px-8 py-3.5 rounded-xl bg-slate-950 hover:bg-slate-800 text-white font-bold text-xs sm:text-sm shadow-md hover:shadow-xl transition-all duration-300 border border-slate-800 active:scale-95 group cursor-pointer"
        >
          <!-- Haz líquido continuo en loop -->
          <span class="expand-sheen-sweep absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-amber-400/25 to-transparent skew-x-12 pointer-events-none"></span>

          <i class="fa-solid fa-layer-group text-amber-400 text-xs relative z-10"></i>
          <span id="toggle-expand-text" class="relative z-10">Ver todos los 32 elementos</span>
          <i id="toggle-expand-icon" class="fa-solid fa-chevron-down text-amber-400 text-xs transition-transform duration-300 group-hover:translate-y-0.5 relative z-10"></i>
        </button>
        <span id="expand-subtext" class="text-[11px] text-slate-500 font-medium">
          Mostrando las primeras 2 filas (8 de 32 elementos certificados)
        </span>
      </div>
    </div>

    <!-- Empty State -->
    <div id="no-elements-msg" class="hidden py-16 text-center bg-white rounded-2xl border border-slate-200 p-8">
      <i class="fa-solid fa-flask text-3xl text-slate-300 mb-3"></i>
      <h4 class="text-base font-bold text-slate-900">No se encontraron elementos coincidentes</h4>
      <p class="text-xs text-slate-500 mt-1">Prueba con otro término de búsqueda o limpia los filtros.</p>
    </div>

  </div>

  <!-- Interactive Detail Modal -->
  <div id="element-modal" class="fixed inset-0 z-50 bg-slate-950/70 backdrop-blur-xs hidden items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-lg w-full p-6 sm:p-8 shadow-2xl border border-slate-200 relative animate-in fade-in zoom-in-95 duration-200">
      
      <button id="close-modal-btn" type="button" class="absolute top-5 right-5 text-slate-400 hover:text-slate-900 text-lg p-2 rounded-lg transition-colors">
        <i class="fa-solid fa-xmark"></i>
      </button>

      <!-- Modal Header -->
      <div class="flex items-center gap-4 mb-6 pb-4 border-b border-slate-100">
        <div class="w-16 h-16 rounded-2xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-3xl font-black font-mono text-amber-600">
          <span id="modal-symbol">Hf</span>
        </div>
        <div>
          <h3 id="modal-name" class="text-2xl font-extrabold text-slate-950 font-['Plus_Jakarta_Sans']">Hafnio</h3>
          <span id="modal-category" class="text-xs font-semibold text-slate-500">Metal Crítico · Microchips IA & Nuclear</span>
        </div>
      </div>

      <!-- Test Values Grid -->
      <div class="grid grid-cols-2 gap-4 mb-6">
        <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-200/80">
          <span class="text-[10px] uppercase font-bold text-slate-400 tracking-wider block">Ensayo T-RARAS01</span>
          <span id="modal-ppm1" class="text-lg font-extrabold text-slate-950 font-mono">8.76 ppm</span>
        </div>
        <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-200/80">
          <span class="text-[10px] uppercase font-bold text-slate-400 tracking-wider block">Ensayo T-RARAS02</span>
          <span id="modal-ppm2" class="text-lg font-extrabold text-slate-950 font-mono">18.25 ppm</span>
        </div>
      </div>

      <!-- Content Breakdown -->
      <div class="space-y-4 text-xs sm:text-sm text-slate-600 mb-6">
        <div>
          <h4 class="font-bold text-slate-900 text-xs uppercase tracking-wider mb-1">Aplicación en Industria de Alta Tecnología:</h4>
          <p id="modal-application" class="leading-relaxed bg-amber-50/60 p-3 rounded-xl border border-amber-200/60 text-slate-800 font-medium">
            Indispensable para la fabricación de microprocesadores para Inteligencia Artificial y semiconductores de última generación.
          </p>
        </div>

        <div>
          <h4 class="font-bold text-slate-900 text-xs uppercase tracking-wider mb-1">Relevancia Geopolítica & Mercado:</h4>
          <p id="modal-geopolitics" class="text-slate-600 text-xs leading-relaxed">
            Representa ~70% del valor in-situ de los metales críticos de la propiedad. Cotizado en ~$38,500/kg con severas restricciones de exportación impuestas por China.
          </p>
        </div>
      </div>

      <!-- Modal Footer Action -->
      <div class="pt-4 border-t border-slate-100 flex items-center justify-between gap-3">
        <a href="#contacto" id="modal-request-btn" class="flex-1 inline-flex items-center justify-center gap-2 bg-slate-950 hover:bg-slate-800 text-white text-xs font-bold py-3 px-4 rounded-xl transition-all shadow-xs">
          <i class="fa-solid fa-file-shield text-amber-400"></i>
          <span>Solicitar Certificado ALS LI26179573</span>
        </a>
        <button id="modal-ok-btn" type="button" class="bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold py-3 px-5 rounded-xl transition-all">
          Cerrar
        </button>
      </div>

    </div>
  </div>

</section>

<style>
  /* =========================================================================
     ANIMACIÓN EN LOOP CONTINUO PARA EL BOTÓN EXPANDIR (32 ELEMENTOS)
     ========================================================================= */
  @keyframes expandBtnGlow {
    0%, 100% {
      border-color: rgba(245, 158, 11, 0.4);
      box-shadow: 0 4px 15px -2px rgba(245, 158, 11, 0.15);
    }
    50% {
      border-color: rgba(245, 158, 11, 0.85);
      box-shadow: 0 0 25px 3px rgba(245, 158, 11, 0.35);
    }
  }

  @keyframes expandSheenSweep {
    0% {
      transform: translateX(-150%) skewX(-20deg);
    }
    30%, 100% {
      transform: translateX(250%) skewX(-20deg);
    }
  }

  .expand-btn-loop {
    animation: expandBtnGlow 3.5s ease-in-out infinite;
  }

  .expand-sheen-sweep {
    animation: expandSheenSweep 3.8s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .expand-btn-loop,
    .expand-sheen-sweep {
      animation: none !important;
    }
  }
</style>

