            <span class="text-[10px] text-slate-500 uppercase tracking-wider font-semibold block">Estados Unidos</span>
          </div>

          <!-- Peru Office -->
          <div class="bg-slate-900/90 rounded-xl p-3.5 border border-slate-800 space-y-1">
