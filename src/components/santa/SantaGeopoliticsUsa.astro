<style>
  /* Animación de Resplandor Continuo & Respiración para el Cuadro de EE.UU. */
  .usa-glow-card {
    position: relative;
    animation: usaCardPulse 4.5s ease-in-out infinite;
    border-color: rgba(59, 130, 246, 0.5);
  }

  @keyframes usaCardPulse {
    0%, 100% {
      box-shadow: 0 0 25px -4px rgba(59, 130, 246, 0.25), 0 0 15px -3px rgba(245, 158, 11, 0.15);
      border-color: rgba(59, 130, 246, 0.5);
      transform: translateY(0);
    }
    50% {
      box-shadow: 0 0 50px 3px rgba(59, 130, 246, 0.45), 0 0 32px 5px rgba(245, 158, 11, 0.35);
      border-color: rgba(245, 158, 11, 0.75);
      transform: translateY(-3px);
    }
  }

  /* Animación de entrada fluida escalonada */
  .geo-reveal {
    opacity: 0;
    transform: translateY(22px);
    transition: opacity 0.75s cubic-bezier(0.16, 1, 0.3, 1), transform 0.75s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .geo-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  // Observador de Intersección para animaciones de entrada progresivas
  const geoSec = document.querySelector('#geopolitica');
  if (geoSec) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          geoSec.querySelectorAll('.geo-reveal').forEach((el) => {
            el.classList.add('is-visible');
          });
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12 });
    observer.observe(geoSec);
  }
</script>
