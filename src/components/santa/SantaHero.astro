---
// Hero Institucional de Las Arenas del Santa con Fotografía Real de la Mina
---

<section
  class="relative min-h-screen pt-28 pb-20 sm:pt-36 sm:pb-28 flex flex-col justify-between overflow-hidden bg-slate-950"
>
  <!-- Real Mine Photo Background with Increased Visibility and Soft Contrast Overlay -->
  <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
    <img
      src="/assets/santa/Frontal.png"
      alt="Placer Aurífero y Minerales Pesados Las Arenas del Santa"
      class="w-full h-full object-cover object-center scale-105 filter brightness-105 contrast-110"
    />
    <!-- Adjusted Multi-layer Gradient: Preserves landscape texture while ensuring text readability -->
    <div
      class="absolute inset-0 bg-gradient-to-b from-slate-950/75 via-slate-950/45 to-slate-950/85"
    >
    </div>
    <div
      class="absolute inset-0 bg-radial-at-c from-transparent via-slate-950/20 to-slate-950/75"
    >
    </div>
    <!-- Subtle technical grid -->
    <div
      class="absolute inset-0 opacity-[0.03]"
      style="background-image: linear-gradient(#F59E0B 1px, transparent 1px), linear-gradient(to right, #F59E0B 1px, transparent 1px); background-size: 40px 40px;"
    >
    </div>
  </div>

  <!-- Central Hero Content -->
  <div
    class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center flex-grow flex flex-col items-center justify-center"
  >
    <!-- Phase 1A: Security / Confidentiality Badge -->
    <div
      class="hero-step-1 hero-step-1-badge inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-slate-950/60 border border-amber-400/50 backdrop-blur-md text-amber-400 text-[11px] sm:text-xs font-bold tracking-widest uppercase mb-6 shadow-sm"
    >
      <span
        class="w-2 h-2 rounded-full bg-amber-400 animate-pulse shadow-sm shadow-amber-400"
      ></span>
      <i class="fa-solid fa-shield-halved text-[10px]"></i>
      <span
        >Estrictamente Confidencial · Exclusivo para Inversionistas Calificados</span
      >
    </div>

    <!-- Phase 1B: Display Main Title -->
    <h1
      class="hero-step-1 hero-step-1-title text-4xl sm:text-6xl lg:text-7xl font-black text-white leading-tight sm:leading-none mb-6 tracking-tight font-['Plus_Jakarta_Sans'] drop-shadow-md"
    >
      Las Arenas del <span
        class="text-amber-400 bg-gradient-to-r from-amber-400 via-amber-300 to-amber-500 bg-clip-text text-transparent"
        >Santa</span
      >
    </h1>

    <!-- Phase 2: Contextualization Paragraph (Jerarquizado & Ejecutivo) -->
    <div class="hero-step-2 max-w-3xl mx-auto mb-10 px-2 sm:px-0">
      <p
        class="text-base sm:text-xl lg:text-2xl text-slate-200 leading-relaxed font-normal drop-shadow-md mb-3"
      >
        Mayor concentración de <strong class="text-amber-300 font-bold">monacita</strong>, <strong class="text-amber-300 font-bold">oro nativo</strong> y <strong class="text-white font-bold">minerales pesados</strong> en el litoral del Pacífico sur.
      </p>
      <!-- Sub-cinta de pilares clave del yacimiento -->
      <div
        class="inline-flex flex-wrap items-center justify-center gap-2 sm:gap-3 px-4 py-1.5 rounded-full bg-slate-950/60 border border-slate-800/90 backdrop-blur-xs text-xs sm:text-[13px] text-slate-300 shadow-xs"
      >
        <span class="inline-flex items-center gap-1.5 text-amber-400 font-bold">
          <i class="fa-solid fa-coins text-[11px]"></i>
          <span>20 MM oz Au Potencial</span>
        </span>
        <span class="text-slate-700">·</span>
        <span class="inline-flex items-center gap-1.5 text-slate-200 font-medium">
          <i class="fa-solid fa-cubes-stacked text-[11px] text-slate-400"></i>
          <span>700 MM TM Magnetita</span>
        </span>
        <span class="text-slate-700">·</span>
        <span class="inline-flex items-center gap-1.5 text-amber-300 font-semibold">
          <i class="fa-solid fa-atom text-[11px]"></i>
          <span>Tierras Raras & Hafnio</span>
        </span>
      </div>
    </div>

    <!-- Phase 3: Dual Actions (CTAs Rediseñados: Cortos, Precisos & Dinámicos) -->
    <div
      class="hero-step-3 flex flex-col sm:flex-row items-center justify-center gap-4 w-full sm:w-auto"
    >
      <!-- CTA Principal con Loop Continuo (Aura respiratoria + barrido de luz) -->
      <a
        href="#contacto"
        class="cta-loop-button relative overflow-hidden w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 rounded-xl bg-gradient-to-r from-amber-500 via-amber-400 to-amber-500 text-slate-950 font-extrabold text-sm tracking-wide shadow-xl transition-all duration-300 hover:-translate-y-0.5 active:scale-95 border border-amber-300/60 group"
      >
        <!-- Destello líquido transversal continuo -->
        <span
          class="cta-liquid-sheen absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-white/40 to-transparent skew-x-12 pointer-events-none"
        ></span>
        <i
          class="fa-solid fa-file-shield text-xs transition-transform duration-300 group-hover:scale-110"
        ></i>
        <span>Solicitar Data Room</span>
        <i
          class="fa-solid fa-arrow-right text-[11px] opacity-75 group-hover:translate-x-1 transition-transform"
        ></i>
      </a>

      <!-- CTA Secundario Preciso -->
      <a
        href="#elementos"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-7 py-4 rounded-xl bg-slate-900/80 hover:bg-slate-800 text-slate-200 hover:text-white font-bold text-sm tracking-wide border border-slate-700/80 hover:border-amber-400/50 backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 active:scale-95 shadow-md group"
      >
        <i
          class="fa-solid fa-layer-group text-amber-400 text-xs transition-transform duration-300 group-hover:rotate-6"
        ></i>
        <span>Explorar 32 Elementos</span>
      </a>
    </div>

    <!-- Phase 4: Validación Científica & Ensayos: Diseño Elegante, Minimalista y Técnico -->
    <div
      class="hero-step-4 w-full max-w-4xl mx-auto mt-12 pt-6 border-t border-slate-800/60"
    >
      <div
        class="flex flex-wrap items-center justify-center gap-2.5 sm:gap-3 text-[11px] sm:text-xs text-slate-300 font-medium"
      >
        <span
          class="inline-flex items-center gap-1.5 bg-slate-950/50 px-3 py-1.5 rounded-lg border border-slate-800/80 backdrop-blur-xs shadow-xs"
        >
          <i class="fa-solid fa-flask-vial text-[10px] text-amber-400/90"></i>
          <span>Certificación ALS Perú S.A. (LI26179573, 2026)</span>
        </span>
        <span
          class="inline-flex items-center gap-1.5 bg-slate-950/50 px-3 py-1.5 rounded-lg border border-slate-800/80 backdrop-blur-xs shadow-xs"
        >
          <i class="fa-solid fa-book-atlas text-[10px] text-amber-400/90"></i>
          <span>Estudio INGEMMET Monacita & Placeres</span>
        </span>
        <span
          class="inline-flex items-center gap-1.5 bg-slate-950/50 px-3 py-1.5 rounded-lg border border-slate-800/80 backdrop-blur-xs shadow-xs"
        >
          <i class="fa-solid fa-bore-hole text-[10px] text-amber-400/90"></i>
          <span>Campaña 41 Calicatas MRC1</span>
        </span>
        <span
          class="inline-flex items-center gap-1.5 bg-slate-950/50 px-3 py-1.5 rounded-lg border border-slate-800/80 backdrop-blur-xs shadow-xs"
        >
          <i class="fa-solid fa-file-shield text-[10px] text-amber-400/90"></i>
          <span>06 Informes Técnicos (1982–2026)</span>
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  /* =========================================================================
     COREOGRAFÍA DE ENTRADA SECUENCIAL ESCALONADA (STAGGER)
     Fase 1: Título y Badge (0.15s - 0.75s)
     Fase 2: Descripción cuando termina el título (0.85s - 1.35s)
     Fase 3: CTAs Rediseñados (1.45s - 1.85s)
     Fase 4: Certificaciones y Ficha Técnica (1.95s - 2.35s)
     ========================================================================= */
  .hero-step-1,
  .hero-step-2,
  .hero-step-3,
  .hero-step-4 {
    opacity: 0;
    transform: translateY(22px);
    animation: heroFadeInUp 0.75s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    will-change: opacity, transform;
  }

  .hero-step-1-badge {
    animation-delay: 0.15s;
  }

  .hero-step-1-title {
    animation-delay: 0.25s;
  }

  .hero-step-2 {
    animation-delay: 0.85s;
  }

  .hero-step-3 {
    animation-delay: 1.45s;
  }

  .hero-step-4 {
    animation-delay: 1.95s;
  }

  @keyframes heroFadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* =========================================================================
     ANIMACIÓN EN LOOP CONTINUO PARA EL CTA PRINCIPAL
     1. Pulso respiratorio del halo perimetral ámbar (3s)
     2. Barrido transversal continuo de destello de luz líquido (3.4s)
     ========================================================================= */
  @keyframes ctaPulseGlow {
    0%,
    100% {
      box-shadow:
        0 0 0 0 rgba(245, 158, 11, 0.5),
        0 10px 25px -5px rgba(245, 158, 11, 0.3);
    }
    50% {
      box-shadow:
        0 0 26px 4px rgba(245, 158, 11, 0.45),
        0 12px 30px -3px rgba(245, 158, 11, 0.4);
    }
  }

  @keyframes ctaLiquidSheen {
    0% {
      transform: translateX(-150%) skewX(-20deg);
    }
    30%,
    100% {
      transform: translateX(250%) skewX(-20deg);
    }
  }

  .cta-loop-button {
    animation: ctaPulseGlow 3s ease-in-out infinite;
  }

  .cta-liquid-sheen {
    animation: ctaLiquidSheen 3.4s ease-in-out infinite;
  }

  /* Accesibilidad: Respeto estricto a la preferencia de movimiento reducido */
  @media (prefers-reduced-motion: reduce) {
    .hero-step-1,
    .hero-step-2,
    .hero-step-3,
    .hero-step-4 {
      opacity: 1 !important;
      transform: none !important;
      animation: none !important;
    }
    .cta-loop-button,
    .cta-liquid-sheen {
      animation: none !important;
    }
  }
</style>

