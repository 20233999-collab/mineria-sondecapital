---
// Hero Institucional de Las Arenas del Santa con Fotografía Real de la Mina
---

<section class="relative min-h-screen pt-28 pb-20 sm:pt-36 sm:pb-28 flex flex-col justify-between overflow-hidden bg-slate-950">
  
  <!-- Real Mine Photo Background with Premium Deep Navy Overlay -->
  <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
    <img 
      src="/assets/santa/Frontal.png" 
      alt="Placer Aurífero y Minerales Pesados Las Arenas del Santa" 
      class="w-full h-full object-cover object-center scale-105 filter brightness-95 contrast-105"
    />
    <!-- Rich Multi-layer Gradient: High readability with navy tone -->
    <div class="absolute inset-0 bg-gradient-to-b from-slate-950/92 via-slate-950/80 to-slate-950/95"></div>
    <div class="absolute inset-0 bg-radial-at-c from-transparent via-slate-950/40 to-slate-950/90"></div>
    <!-- Subtle technical grid -->
    <div 
      class="absolute inset-0 opacity-[0.04]"
      style="background-image: linear-gradient(#F59E0B 1px, transparent 1px), linear-gradient(to right, #F59E0B 1px, transparent 1px); background-size: 40px 40px;"
    ></div>
  </div>

  <!-- Central Hero Content -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center flex-grow flex flex-col items-center justify-center">
    
    <!-- Security / Confidentiality Badge -->
    <div class="hero-item inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-slate-950/40 border border-amber-400/50 backdrop-blur-md text-amber-400 text-[11px] sm:text-xs font-bold tracking-widest uppercase mb-6 shadow-sm">
      <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse shadow-sm shadow-amber-400"></span>
      <i class="fa-solid fa-shield-halved text-[10px]"></i>
      <span>Estrictamente Confidencial · Exclusivo para Inversionistas Calificados</span>
    </div>

    <!-- Display Main Title -->
    <h1 class="hero-item text-4xl sm:text-6xl lg:text-7xl font-black text-white leading-tight sm:leading-none mb-4 tracking-tight font-['Plus_Jakarta_Sans']">
      Las Arenas del <span class="text-amber-400 bg-gradient-to-r from-amber-400 via-amber-300 to-amber-500 bg-clip-text text-transparent">Santa</span>
    </h1>

    <!-- Positioning Subtitle -->
    <p class="hero-item text-lg sm:text-2xl text-amber-300/90 font-bold max-w-3xl mx-auto mb-6 tracking-normal">
      Depósito de Placer Aurífero & Minerales Pesados de Origen Fluvio-Marino
    </p>

    <!-- Contextualization Paragraph (Resumen en 2 líneas) -->
    <p class="hero-item text-base sm:text-lg lg:text-xl text-slate-200 max-w-4xl mx-auto mb-10 leading-relaxed font-normal">
      <span class="block text-white font-semibold">Mayor concentración de monacita, oro nativo y minerales pesados en el litoral del Pacífico sur.</span>
      <span class="block text-slate-300 text-sm sm:text-base mt-1 font-normal">2,100 hectáreas consolidadas con 32 elementos certificados por ALS (2026) y salida portuaria directa a Salaverry y Chancay.</span>
    </p>

    <!-- Dual Actions (CTAs) -->
    <div class="hero-item flex flex-col sm:flex-row items-center justify-center gap-4 w-full sm:w-auto">
      <a 
        href="#elementos" 
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-extrabold text-sm tracking-wide shadow-xl shadow-amber-500/20 transition-all duration-300 hover:-translate-y-0.5 active:scale-95 border border-amber-400/40"
      >
        <i class="fa-solid fa-layer-group text-xs"></i>
        <span>Explorar los 32 Elementos & TTRR</span>
      </a>

      <a 
        href="#contacto" 
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 rounded-xl bg-slate-900/80 hover:bg-slate-800 text-slate-200 hover:text-white font-bold text-sm tracking-wide border border-slate-700/80 hover:border-slate-500 backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 active:scale-95 shadow-md"
      >
        <i class="fa-solid fa-calendar-check text-amber-400 text-xs"></i>
        <span>Agendar Reunión con el Equipo Directivo</span>
      </a>
    </div>

    <!-- Validación Científica & Ensayos: Diseño Elegante, Minimalista y "Caleta" -->
    <div class="hero-item w-full max-w-4xl mx-auto mt-12 pt-6 border-t border-slate-800/50">
      <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-[11px] text-slate-400 font-medium">
        <span class="inline-flex items-center gap-1.5">
          <i class="fa-solid fa-flask-vial text-[10px] text-slate-500"></i>
          <span>Certificación ALS Perú S.A. (LI26179573, 2026)</span>
        </span>
        <span class="hidden sm:inline text-slate-700">·</span>
        <span class="inline-flex items-center gap-1.5">
          <i class="fa-solid fa-book-atlas text-[10px] text-slate-500"></i>
          <span>Estudio INGEMMET Monacita & Placeres</span>
        </span>
        <span class="hidden sm:inline text-slate-700">·</span>
        <span class="inline-flex items-center gap-1.5">
          <i class="fa-solid fa-bore-hole text-[10px] text-slate-500"></i>
          <span>Campaña 41 Calicatas MRC1</span>
        </span>
        <span class="hidden sm:inline text-slate-700">·</span>
        <span class="inline-flex items-center gap-1.5">
          <i class="fa-solid fa-file-shield text-[10px] text-slate-500"></i>
          <span>06 Informes Técnicos (1982–2026)</span>
        </span>
      </div>
    </div>

  </div>

</section>

<style>
  .hero-item {
    opacity: 0;
    transform: translateY(20px);
    animation: heroFadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .hero-item:nth-child(1) { animation-delay: 0.1s; }
  .hero-item:nth-child(2) { animation-delay: 0.25s; }
  .hero-item:nth-child(3) { animation-delay: 0.4s; }
  .hero-item:nth-child(4) { animation-delay: 0.55s; }
  .hero-item:nth-child(5) { animation-delay: 0.7s; }

  @keyframes heroFadeUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
