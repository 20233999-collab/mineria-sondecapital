        data-animate="fade-up" 
        data-delay="600"
        class="bg-slate-950 border border-slate-800 hover:border-slate-700 rounded-2xl p-7 shadow-lg flex flex-col justify-between group transition-all duration-300"
      >
        <div class="flex items-center justify-between mb-4">
          <span class="text-[11px] font-extrabold uppercase tracking-wider px-2.5 py-1 rounded-full bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
            Operatividad Total
