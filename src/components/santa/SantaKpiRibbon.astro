          <div class="text-3xl sm:text-4xl font-black text-white font-mono tracking-tight">
            <span class="scramble-santa" data-final="100% Tajo Abierto" data-delay="1500">100% Tajo Abierto</span>
          </div>
          <p class="text-xs text-slate-400 mt-2 leading-relaxed">
            Arenas en superficie sin perforación en roca dura ni galerías subterráneas. A 75 km de Salaverry y con conexión a Chancay.
          </p>
        </div>

        <div class="mt-5 pt-4 border-t border-slate-800/80 text-xs text-slate-400 flex items-center gap-1.5">
          <i class="fa-solid fa-route text-emerald-400 text-[11px]"></i>
          <span>21–23 días directo a Asia por Chancay</span>
        </div>
      </div>

    </div>

  </div>
</section>

<style>
  /* =========================================================================
     ANIMACIONES EN LOOP CONTINUO PARA LA TARJETA PRINCIPAL ($690 MM+ USD)
     1. cardGlowPulse: Pulso perimetral dorado continuo (3.5s)
     2. cardSheenSweep: Haz de luz líquido que cruza la tarjeta (3.8s)
     3. cardOrbBreathe: Respiración del fondo lumínico difuso (3.5s)
     ========================================================================= */
  @keyframes cardGlowPulse {
    0%, 100% {
      border-color: rgba(245, 158, 11, 0.75);
      box-shadow: 0 0 16px 1px rgba(245, 158, 11, 0.22), 0 20px 25px -5px rgba(0, 0, 0, 0.5);
    }
    50% {
      border-color: rgba(251, 191, 36, 1);
      box-shadow: 0 0 32px 3px rgba(245, 158, 11, 0.42), 0 25px 35px -5px rgba(0, 0, 0, 0.6);
    }
  }

  @keyframes cardSheenSweep {
    0% {
      transform: translateX(-150%) skewX(-20deg);
    }
    32%, 100% {
      transform: translateX(250%) skewX(-20deg);
    }
  }

  @keyframes cardOrbBreathe {
    0%, 100% {
      opacity: 0.3;
      transform: scale(0.95);
    }
    50% {
      opacity: 0.75;
      transform: scale(1.15);
    }
  }

  .card-glow-loop {
    animation: cardGlowPulse 3.5s ease-in-out infinite;
  }

  .card-sweep-sheen {
    animation: cardSheenSweep 3.8s ease-in-out infinite;
  }

  .card-orb-loop {
    animation: cardOrbBreathe 3.5s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .card-glow-loop,
    .card-sweep-sheen,
    .card-orb-loop {
      animation: none !important;
    }
  }
</style>

<!-- Progressive Cascading Number Scramble Animation Script -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const scrambleElements = document.querySelectorAll('.scramble-santa');
    if (!scrambleElements.length) return;

    const chars = '0123456789$MB+ha%km.,TM';
    let observerTriggered = false;

    const runScramble = (el) => {
      const finalVal = el.getAttribute('data-final');
      const delay = parseInt(el.getAttribute('data-delay') || '0', 10);
      let iteration = 0;
      const totalSteps = 16;

      setTimeout(() => {
        const interval = setInterval(() => {
          el.innerText = finalVal
            .split('')
            .map((letter, idx) => {
              if (idx < (iteration / totalSteps) * finalVal.length) {
                return finalVal[idx];
              }
              if (letter === ' ') return ' ';
              return chars[Math.floor(Math.random() * chars.length)];
            })
            .join('');

          iteration++;
          if (iteration > totalSteps) {
            clearInterval(interval);
            el.innerText = finalVal;
          }
        }, 40);
      }, delay);
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting && !observerTriggered) {
          observerTriggered = true;
          scrambleElements.forEach((el) => runScramble(el));
          observer.disconnect();
        }
      });
    }, { threshold: 0.2 });

    const escalaSection = document.getElementById('escala');
    if (escalaSection) {
      observer.observe(escalaSection);
    }
  });
</script>

