        <div class="mt-5 pt-4 border-t border-slate-800/80 text-xs text-slate-400 flex items-center gap-1.5">
          <i class="fa-solid fa-route text-emerald-400 text-[11px]"></i>
          <span>21–23 días directo a Asia por Chancay</span>
        </div>
      </div>

    </div>

  </div>
</section>

<!-- Progressive Cascading Number Scramble Animation Script -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const scrambleElements = document.querySelectorAll('.scramble-santa');
    if (!scrambleElements.length) return;

    const chars = '0123456789$MB+ha%km.,';
    let observerTriggered = false;

    const runScramble = (el) => {
      const finalVal = el.getAttribute('data-final');
      const delay = parseInt(el.getAttribute('data-delay') || '0', 10);
      let iteration = 0;
      const totalSteps = 16;

      setTimeout(() => {
        const interval = setInterval(() => {
          el.innerText = finalVal
            .split('')
            .map((letter, idx) => {
              if (idx < (iteration / totalSteps) * finalVal.length) {
                return finalVal[idx];
              }
              if (letter === ' ') return ' ';
              return chars[Math.floor(Math.random() * chars.length)];
            })
            .join('');

          iteration++;
          if (iteration > totalSteps) {
            clearInterval(interval);
            el.innerText = finalVal;
          }
        }, 40);
      }, delay);
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting && !observerTriggered) {
          observerTriggered = true;
          scrambleElements.forEach((el) => runScramble(el));
          observer.disconnect();
        }
      });
    }, { threshold: 0.2 });

    const escalaSection = document.getElementById('escala');
    if (escalaSection) {
      observer.observe(escalaSection);
    }
  });
</script>
