      <p class="text-xs sm:text-sm text-slate-400 mt-2">
        Datos verificados mediante 41 calicatas, 6 estudios independientes y certificación analítica ALS 2026. Cero proyecciones especulativas.
      </p>
    </div>

    <!-- 6 Bento Grid Cards con Stagger de Entrada -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      
      <!-- Card 1: $690 MM+ USD (Sale / Asking Price) - Featured Accent con LOOP CONTINUO -->
      <div 
        data-animate="fade-up" 
        data-delay="100"
        class="card-glow-loop bg-gradient-to-b from-slate-900 via-slate-900 to-slate-950 border-2 border-amber-500/80 rounded-2xl p-7 shadow-xl shadow-amber-500/10 flex flex-col justify-between relative overflow-hidden group hover:border-amber-300 transition-all duration-300"
