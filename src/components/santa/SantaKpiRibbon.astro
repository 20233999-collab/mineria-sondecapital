        <!-- Aura respiratoria en loop -->
        <div class="card-orb-loop absolute -top-12 -right-12 w-36 h-36 bg-amber-500/20 rounded-full blur-2xl pointer-events-none"></div>
        
        <!-- Haz de destello transversal en loop -->
        <span class="card-sweep-sheen absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-amber-400/15 to-transparent skew-x-12 pointer-events-none"></span>

        <div class="flex items-center justify-between mb-4 relative z-10">
          <span class="text-[11px] font-extrabold uppercase tracking-wider px-2.5 py-1 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/30">
            Adquisición Completa
