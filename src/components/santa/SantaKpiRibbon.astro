        </div>

        <div class="relative z-10">
          <p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Precio de Venta Solicitado</p>
          <div class="flex items-baseline gap-1 text-3xl sm:text-4xl font-black text-white font-mono tracking-tight text-amber-400">
            <span class="scramble-santa" data-final="$690 MM+ USD" data-delay="0">$690 MM+ USD</span>
