---
// Página Principal de Rediseño: Las Arenas del Santa (Mina Santa)
// Dominio: santa.sondecapital.com (enrutado vía vercel.json)
import Layout from '../../layouts/Layout.astro';
import SantaHeader from '../../components/santa/SantaHeader.astro';
import SantaHero from '../../components/santa/SantaHero.astro';
import SantaKpiRibbon from '../../components/santa/SantaKpiRibbon.astro';
import SantaGeopoliticsUsa from '../../components/santa/SantaGeopoliticsUsa.astro';
import SantaAnchorAssets from '../../components/santa/SantaAnchorAssets.astro';
import SantaSpecialMinerals from '../../components/santa/SantaSpecialMinerals.astro';
import SantaElementsMatrix from '../../components/santa/SantaElementsMatrix.astro';
import SantaGeologyLogistics from '../../components/santa/SantaGeologyLogistics.astro';
import SantaInvestmentRoom from '../../components/santa/SantaInvestmentRoom.astro';
import SantaFooter from '../../components/santa/SantaFooter.astro';
---

<Layout
  title="Las Arenas del Santa | Placer Aurífero & Minerales Pesados | Sonde Capital"
  description="Depósito de placer aurífero y minerales pesados en la costa del Pacífico. 32 elementos confirmados por ALS (2026), monacita, hafnio, escandio, 700 MM TM de magnetita y 20 MM oz de oro en 2,100 hectáreas."
  hideHeader={true}
  hideFooter={true}
>
  <!-- 1. Header Slim Sticky con navegación táctica y botón directo a NDA -->
  <SantaHeader />

  <main class="overflow-hidden">
    <!-- 2. Hero Institucional con fotografía real de la mina y propuesta de valor -->
    <SantaHero />

    <!-- 3. Bento Grid de Escala Verificada & KPI Duros ($690 MM USD) -->
    <SantaKpiRibbon />

    <!-- 4. Contexto Geoestratégico: El Nexo Perú-EE.UU. & Minerales de Defensa -->
    <SantaGeopoliticsUsa />

    <!-- 5. Activos Ancla de Liquidez Inmediata: Oro ($4.4k/oz) & Magnetita (700M TM) -->
    <SantaAnchorAssets />

    <!-- 6. Los 7 Minerales Especiales de Placer (Monacita, Ilmenita, Andalucita, etc.) -->
    <SantaSpecialMinerals />

    <!-- 7. Matriz Dinámica e Interactiva de los 32 Elementos Certificados por ALS 2026 -->
    <SantaElementsMatrix />

    <!-- 8. Ficha Geológica, Calicatas Históricas & Acceso Portuario Salaverry/Chancay -->
    <SantaGeologyLogistics />

    <!-- 9. Estructuras de Inversión ($690M, JV, EXW), Cronograma y Data Room -->
    <SantaInvestmentRoom />

    <!-- 10. Footer Corporativo Dedicado: Oficinas en EE.UU. & Perú -->
    <SantaFooter />
  </main>
</Layout>

<style is:global>
  /* =========================================================================
     ESTILOS GLOBALES & ANIMACIONES ON SCROLL (Skill: animation-on-scroll)
     ========================================================================= */
  [data-animate="fade-up"] {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.75s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.75s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform;
  }

  [data-animate="fade-up"].in-view {
    opacity: 1;
    transform: translateY(0);
  }

  /* Suavizado de desplazamiento */
  html {
    scroll-behavior: smooth;
    scroll-padding-top: 5rem;
  }

  /* Números tabulares para alineación contable perfecta en datos técnicos */
  .tabular-nums {
    font-feature-settings: "tnum" 1, "cv05" 1;
  }
</style>

<script is:inline>
  // Script de Inicialización de Animaciones on-scroll
  document.addEventListener('DOMContentLoaded', () => {
    const animatedElements = document.querySelectorAll('[data-animate]');

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries, obs) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const el = entry.target;
            const delay = el.getAttribute('data-delay') || '0';
            
            setTimeout(() => {
              el.classList.add('in-view');
            }, parseInt(delay, 10));

            obs.unobserve(el);
          }
        });
      }, {
        root: null,
        rootMargin: '0px 0px -50px 0px',
        threshold: 0.08
      });

      animatedElements.forEach(el => observer.observe(el));
    } else {
      animatedElements.forEach(el => el.classList.add('in-view'));
    }
  });
</script>
