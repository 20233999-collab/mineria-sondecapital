<script is:inline src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    // 1. Gold Grades Chart
    const canvasGrades = document.getElementById('santaGradesChart');
    if (canvasGrades) {
      const ctxGrades = canvasGrades.getContext('2d');
      new Chart(ctxGrades, {
        type: 'bar',
        data: {
          labels: ['Playa Norte', 'Playa Centro', 'Playa Sur'],
          datasets: [
            {
              label: 'Tenor de Au (mg/m³)',
              data: [75, 65, 75],
              backgroundColor: [
                'rgba(217, 119, 6, 0.85)',
                'rgba(245, 158, 11, 0.85)',
                'rgba(217, 119, 6, 0.85)'
              ],
              borderRadius: 6,
              borderSkipped: false,
              barPercentage: 0.55
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: '#0F172A',
              titleFont: { family: "'Plus Jakarta Sans', sans-serif", size: 13 },
              bodyFont: { family: "'Inter', sans-serif", size: 12 },
              padding: 12,
              cornerRadius: 8,
              callbacks: {
                label: function (context) {
                  return context.parsed.y + ' mg/m³ (promedio)';
                }
              }
            }
          },
          scales: {
            y: {
              beginAtZero: true,
              grid: { color: 'rgba(15, 23, 42, 0.06)' },
              ticks: { font: { family: "'Inter', sans-serif" }, color: '#64748B' }
            },
            x: {
              grid: { display: false },
              ticks: { font: { family: "'Inter', sans-serif" }, color: '#64748B' }
            }
          }
        }
      });
    }

    // 2. Value Distribution Chart
    const canvasValue = document.getElementById('santaValueChart');
    if (canvasValue) {
      const ctxValue = canvasValue.getContext('2d');
      new Chart(ctxValue, {
        type: 'doughnut',
        data: {
          labels: ['Hafnio (Hf)', 'Escandio (Sc)', 'Otros (Tierras Raras, Galio, etc.)'],
          datasets: [
            {
              data: [70, 17, 13],
              backgroundColor: ['#0F172A', '#0D9488', '#CBD5E1'],
              borderWidth: 0,
              hoverOffset: 4
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          cutout: '68%',
          plugins: {
            legend: {
              position: 'bottom',
              labels: {
                font: { family: "'Inter', sans-serif", size: 12 },
                color: '#334155',
                usePointStyle: true,
                padding: 15
              }
            },
            tooltip: {
              backgroundColor: '#0F172A',
              titleFont: { family: "'Plus Jakarta Sans', sans-serif", size: 13 },
              bodyFont: { family: "'Inter', sans-serif", size: 12 },
              padding: 12,
              cornerRadius: 8,
              callbacks: {
                label: function (context) {
                  return ' ' + context.parsed + '% del valor in-situ estimado';
                }
              }
            }
          }
        }
      });
    }
  });
</script>
