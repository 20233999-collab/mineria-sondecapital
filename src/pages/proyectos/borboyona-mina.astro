---
import Layout from '../../layouts/Layout.astro';
import BorboyonaGalleryCarousel from '../../components/BorboyonaGalleryCarousel.astro';
import BorboyonaAltitudeViewer from '../../components/BorboyonaAltitudeViewer.astro';
import TesoroStructureExplorer from '../../components/TesoroStructureExplorer.astro';
import CriticalMetalsMatrix from '../../components/CriticalMetalsMatrix.astro';
import GlobalBenchmarking from '../../components/GlobalBenchmarking.astro';
import ChancayLogisticsCorridor from '../../components/ChancayLogisticsCorridor.astro';
---

<Layout
  title="Mina Polimetálica Borboyona & Tocllano | Sonde Capital"
  description="Depósito de skarn y vetas polimetálicas de alta ley de clase mundial en Huancavelica, Perú. +3,000 millones de toneladas de recursos inferidos, estructura El Tesoro de 6 km y leyes excepcionales de plata, cobre, plomo y zinc."
>
  <!-- 1. KINETIC SPATIAL HERO SECTION (HIGH DYNAMISM & IMPACT) -->
  <section class="relative overflow-hidden bg-gradient-to-b from-slate-950 via-slate-900 to-slate-950 text-white pt-24 pb-20 sm:pt-36 sm:pb-32 border-b border-slate-800">
    <!-- Ambient texture and luminous atmospheric bloom -->
    <div class="absolute inset-0 opacity-20 pointer-events-none">
      <img
        src="/assets/Oro 6.jpg"
        alt="Geology Texture"
        class="w-full h-full object-cover mix-blend-luminosity grayscale scale-105"
      />
    </div>
    
    <!-- Concentrated glowing orbs -->
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[700px] h-[400px] bg-gradient-to-tr from-amber-500/20 via-yellow-400/10 to-blue-600/15 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center z-10">
      <!-- Status & Confidentiality Badge -->
      <div class="hero-enter-badge inline-flex items-center gap-2 px-3 sm:px-4 py-1.5 sm:py-2 rounded-full bg-slate-900/90 border border-amber-500/40 text-amber-300 text-[10px] sm:text-xs font-extrabold uppercase tracking-wider sm:tracking-widest mb-6 backdrop-blur-md shadow-lg shadow-amber-500/5 max-w-full text-center">
        <span class="w-2 h-2 rounded-full bg-amber-400 animate-ping shrink-0"></span>
        <span class="truncate sm:whitespace-normal">Activo Polimetálico de Escala Mundial · Oportunidad M&amp;A</span>
      </div>

      <!-- Main Kinetic Headline (Paso 1: Aparece Primero) -->
      <div class="hero-enter-title max-w-5xl mx-auto mb-6">
        <span class="text-[11px] sm:text-sm font-extrabold uppercase tracking-[0.25em] sm:tracking-[0.3em] text-slate-400 block mb-2">
          Depósito Polimetálico de Escala Mundial · Perú
        </span>
        <h1 class="text-3xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white leading-[1.15] sm:leading-[1.1]">
          Mina Polimetálica <br />
          <span class="relative inline-block mt-1 sm:mt-2">
            <!-- Aura dorada luminosa sutil detrás del texto -->
            <span class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-4/5 h-10 sm:h-12 bg-amber-500/10 blur-2xl sm:blur-3xl rounded-full pointer-events-none gold-aura-halo -z-10"></span>
            
            <span class="gold-radiance-title font-extrabold tracking-tight">
              Borboyona
            </span>
          </span>
        </h1>
      </div>

      <!-- Subtitle (Paso 2: Aparece después de que el título termina de entrar) -->
      <p class="hero-enter-desc text-sm sm:text-xl text-slate-300 max-w-3xl mx-auto leading-relaxed mb-8 sm:mb-10 font-normal px-2 sm:px-0">
        Un yacimiento tipo Skarn y Vetas de alta ley con potencial documentado de <strong class="text-white">+3,000 Millones de Toneladas</strong>. Calificado por la Universidad de Stanford como un <em class="text-amber-300 not-italic font-bold">«monstruo geológico»</em> análogo a Antamina y Bingham Canyon.
      </p>

      <!-- Action Buttons (Paso 3: Aparece después de la descripción - Opción 1 Concisa) -->
      <div class="hero-enter-cta flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4 max-w-lg mx-auto mb-10 sm:mb-14 w-full">
        <a
          href="#dataroom"
          class="btn-nested w-full sm:w-auto bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-700 text-slate-950 shadow-xl shadow-amber-500/10 group justify-center cursor-pointer"
        >
          <span>Solicitar Data Room</span>
          <div class="btn-nested-icon bg-slate-950/10 text-slate-950 shrink-0">
            <i class="fa-solid fa-lock text-xs"></i>
          </div>
        </a>

        <a
          href="#altitud"
          class="btn-nested w-full sm:w-auto bg-slate-900 hover:bg-slate-800 text-white border border-slate-700 group justify-center cursor-pointer"
        >
          <span>Explorar Socavón</span>
          <div class="btn-nested-icon bg-slate-800 text-amber-400 shrink-0">
            <i class="fa-solid fa-arrow-down text-xs"></i>
          </div>
        </a>
      </div>

      <!-- Photographic Gallery & Field Showcase Carousel (Paso 4: Suave entrada) -->
      <div class="hero-enter-carousel w-full">
        <BorboyonaGalleryCarousel />
      </div>
    </div>
  </section>

  <!-- 2. INTERACTIVE TESORO EXPLORER SECTION -->
  <section id="tesoro" class="py-20 sm:py-28 bg-slate-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <TesoroStructureExplorer />
    </div>
  </section>

  <!-- 3. INTERACTIVE ALTITUDE & ADITS SLICER SECTION -->
  <section id="altitud" class="py-20 sm:py-28 bg-slate-50 border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <BorboyonaAltitudeViewer />
    </div>
  </section>

  <!-- 4. CRITICAL METALS & ENERGY TRANSITION MATRIX -->
  <section id="minerales" class="py-20 sm:py-28 bg-white border-y border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <CriticalMetalsMatrix />
    </div>
  </section>

  <!-- 5. STANFORD BENCHMARKING (ANTAMINA, BINGHAM, ESCONDIDA) -->
  <section id="benchmarking" class="py-20 sm:py-28 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <GlobalBenchmarking />
    </div>
  </section>

  <!-- 6. LOGISTICS & CHANCAY MEGAPORT CORRIDOR -->
  <section id="logistica" class="py-20 sm:py-28 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ChancayLogisticsCorridor />
    </div>
  </section>

  <!-- 7. LEGAL, SOCIAL & PERU RISK-FREE ENVIRONMENT -->
  <section class="py-14 sm:py-28 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-16">
        <span class="text-xs uppercase font-extrabold tracking-widest text-amber-600 block mb-2">
          Garantía Institucional
        </span>
        <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
          Seguridad Jurídica, Licencia Social y Marco Perú
        </h2>
        <p class="text-slate-600 text-xs sm:text-base mt-2">
          Activo libre de contingencias, listo para transferencia inmediata de derechos mineros e infraestructura subterránea.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
        <!-- 100% Titulado -->
        <div class="bg-white p-6 sm:p-8 rounded-2xl sm:rounded-3xl border border-slate-200 shadow-xs card-hover">
          <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl sm:rounded-2xl bg-slate-900 text-amber-400 flex items-center justify-center text-lg sm:text-xl mb-4 sm:mb-6">
            <i class="fa-solid fa-scale-balanced"></i>
          </div>
          <h4 class="text-base sm:text-lg font-bold text-slate-900 mb-2">Estatus Legal 100% Saneado</h4>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Las 13 concesiones (5,500 ha) se encuentran totalmente tituladas bajo el Decreto Ley 708, libres de gravámenes, cargas, litigios limítrofes o disputas judiciales. Derechos de vigencia al día.
          </p>
          <div class="mt-4 sm:mt-6 pt-3 sm:pt-4 border-t border-slate-100 text-xs font-bold text-emerald-600 flex items-center gap-1.5">
            <i class="fa-solid fa-check"></i> Transferencia inmediata
          </div>
        </div>

        <!-- Licencia Social -->
        <div class="bg-white p-6 sm:p-8 rounded-2xl sm:rounded-3xl border border-slate-200 shadow-xs card-hover">
          <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl sm:rounded-2xl bg-slate-900 text-amber-400 flex items-center justify-center text-lg sm:text-xl mb-4 sm:mb-6">
            <i class="fa-solid fa-handshake-angle"></i>
          </div>
          <h4 class="text-base sm:text-lg font-bold text-slate-900 mb-2">Licencia Social de Ticrapo</h4>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Relación de mutuo beneficio y diálogo activo con la comunidad de Ticrapo y distritos aledaños. Convenios vigentes de servidumbre superficial y programas de dinamismo económico regional.
          </p>
          <div class="mt-4 sm:mt-6 pt-3 sm:pt-4 border-t border-slate-100 text-xs font-bold text-emerald-600 flex items-center gap-1.5">
            <i class="fa-solid fa-check"></i> Convivencia armónica garantizada
          </div>
        </div>

        <!-- Marco País Perú -->
        <div class="bg-white p-6 sm:p-8 rounded-2xl sm:rounded-3xl border border-slate-200 shadow-xs card-hover">
          <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl sm:rounded-2xl bg-slate-900 text-amber-400 flex items-center justify-center text-lg sm:text-xl mb-4 sm:mb-6">
            <i class="fa-solid fa-shield-halved"></i>
          </div>
          <h4 class="text-base sm:text-lg font-bold text-slate-900 mb-2">Estabilidad Fiscal y Macroeconómica</h4>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Perú ofrece estabilidad constitucional, libre repatriación del 100% de utilidades, convenios de estabilidad jurídica y régimen de devolución definitiva de IGV para exploración.
          </p>
          <div class="mt-4 sm:mt-6 pt-3 sm:pt-4 border-t border-slate-100 text-xs font-bold text-emerald-600 flex items-center gap-1.5">
            <i class="fa-solid fa-check"></i> Top 2 productor global de Cobre, Zinc y Plata
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 8. DATA ROOM ACCESS TERMINAL & NDA REQUEST -->
  <section id="contacto" class="py-14 sm:py-24 bg-slate-950 text-white relative overflow-hidden">
    <div class="absolute top-0 right-0 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-slate-900 border border-slate-800 rounded-2xl sm:rounded-3xl p-5 sm:p-12 shadow-2xl">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
          <div class="lg:col-span-6 space-y-4 sm:space-y-6">
            <span class="text-xs uppercase font-extrabold tracking-widest text-amber-400 block">
              Proceso Transaccional Confidencial
            </span>
            <h3 class="text-xl sm:text-4xl font-extrabold text-white leading-tight">
              Solicitar Data Room & Due Diligence Técnico
            </h3>
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
              El acceso a los certificados originales de laboratorio (ALS Chemex / SGS), mapas topográficos, cubicación de socavones y el modelo geológico 3D requiere la formalización de un acuerdo de confidencialidad (NDA).
            </p>

            <div class="space-y-3 pt-2 text-xs text-slate-400">
              <div class="flex items-center gap-2">
                <i class="fa-solid fa-file-shield text-amber-400"></i>
                <span>Estudios validados por MVM Exploraciones y Dr. Marco Einaudi (Stanford)</span>
              </div>
              <div class="flex items-center gap-2">
                <i class="fa-solid fa-helicopter text-amber-400"></i>
                <span>Visitas técnicas guiadas a la mina disponibles para delegaciones acreditadas</span>
              </div>
            </div>
          </div>

          <div class="lg:col-span-6 bg-white text-slate-900 p-5 sm:p-8 rounded-2xl shadow-xl">
            <form 
              id="borboyona-form"
              action="/api/contact" 
              method="POST" 
              class="space-y-4"
            >
              <!-- Anti-spam & Hidden Metadata -->
              <input type="text" name="_honey" style="display:none" />
              <input type="hidden" name="proyecto" value="Mina Polimetálica Borboyona & Tocllano (Huancavelica)" />

              <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Nombre Completo *</label>
                <input
                  type="text"
                  name="nombre"
                  required
                  placeholder="Ej. Ing. Roberto Valdivia"
                  class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:bg-white transition-all"
                />
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Empresa / Fondo / Trading House *</label>
                <input
                  type="text"
                  name="empresa"
                  required
                  placeholder="Ej. Global Resource Partners"
                  class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:bg-white transition-all"
                />
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Correo Electrónico Corporativo *</label>
                <input
                  type="email"
                  name="email"
                  required
                  placeholder="rvaldivia@holding.com"
                  class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:bg-white transition-all"
                />
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Interés Transaccional *</label>
                <select name="interes_transaccional" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:bg-white transition-all">
                  <option value="Adquisición Total (Venta 100%)">Adquisición Total del Activo (Venta 100%)</option>
                  <option value="Joint Venture / Operador Estratégico">Joint Venture / Operador Estratégico</option>
                  <option value="Acuerdo Offtake / Financiamiento">Acuerdo de Offtake / Financiamiento</option>
                  <option value="Solicitar Visita Técnica a Mina">Solicitar Visita Técnica a Mina</option>
                </select>
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Requerimientos Específicos (Opcional)</label>
                <textarea
                  rows="2"
                  name="mensaje"
                  placeholder="Indique si requiere información sobre las concesiones o programación de visita a Huancavelica..."
                  class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:bg-white transition-all"
                ></textarea>
              </div>

              <div class="pt-2">
                <button
                  id="borboyona-submit-btn"
                  type="submit"
                  class="w-full bg-slate-950 hover:bg-slate-900 text-white font-bold py-3.5 px-6 rounded-xl transition-all shadow-md flex justify-center items-center gap-2 text-sm active:scale-95 cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed"
                >
                  <i id="borboyona-btn-icon" class="fa-solid fa-lock text-amber-400 text-xs"></i>
                  <span id="borboyona-btn-text">Solicitar Acceso al Data Room</span>
                </button>
              </div>
            </form>

            <!-- Error Alert Message -->
            <div id="borboyona-error-message" class="hidden mt-4 p-4 rounded-xl bg-amber-50 border border-amber-200 text-amber-900 text-xs">
              <div class="flex items-center gap-2 font-bold mb-1">
                <i class="fa-solid fa-triangle-exclamation text-amber-600"></i>
                <span>Aviso de Transmisión</span>
              </div>
              <p class="text-amber-800 leading-relaxed mb-2" id="borboyona-error-text">
                No se pudo procesar el envío automático. Por favor remita su solicitud directamente a nuestra Dirección de Inversiones:
              </p>
              <a id="borboyona-error-mailto" href="mailto:miguel.ampuero@sondecapital.com" class="inline-flex items-center gap-1.5 font-bold text-amber-900 underline hover:text-amber-700">
                <i class="fa-solid fa-envelope"></i> miguel.ampuero@sondecapital.com
              </a>
            </div>

            <!-- Success Alert Message -->
            <div id="borboyona-success-message" class="hidden mt-4 p-5 rounded-2xl bg-teal-50 border border-teal-200 text-teal-900 text-xs sm:text-sm">
              <div class="flex items-center gap-2 font-bold mb-1 text-teal-950">
                <i class="fa-solid fa-circle-check text-teal-600 text-base"></i>
                <span>Solicitud Registrada con Éxito</span>
              </div>
              <p class="text-xs text-teal-800 leading-relaxed">
                Su solicitud ha sido remitida a la Dirección de Inversiones (<strong class="text-teal-950 font-semibold">miguel.ampuero333@gmail.com</strong>). El equipo directivo de Sonde Capital enviará las credenciales a su correo corporativo en un plazo máximo de 24 horas hábiles.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    const borboyonaForm = document.getElementById('borboyona-form');
    const borboyonaSuccessMsg = document.getElementById('borboyona-success-message');
    const borboyonaErrorMsg = document.getElementById('borboyona-error-message');
    const borboyonaSubmitBtn = document.getElementById('borboyona-submit-btn');
    const borboyonaBtnIcon = document.getElementById('borboyona-btn-icon');
    const borboyonaBtnText = document.getElementById('borboyona-btn-text');

    if (borboyonaForm) {
      borboyonaForm.addEventListener('submit', async (e) => {
        e.preventDefault();

        if (borboyonaSubmitBtn) borboyonaSubmitBtn.disabled = true;
        if (borboyonaBtnIcon) borboyonaBtnIcon.className = "fa-solid fa-circle-notch fa-spin text-amber-400 text-xs";
        if (borboyonaBtnText) borboyonaBtnText.textContent = "Transmitiendo Solicitud...";
        if (borboyonaErrorMsg) borboyonaErrorMsg.classList.add('hidden');

        const formData = new FormData(borboyonaForm);
        const data = Object.fromEntries(formData.entries());
        data['origen_url'] = window.location.href;
        data['fecha_hora'] = new Date().toLocaleString('es-PE', { timeZone: 'America/Lima' });

        try {
          const response = await fetch("/api/contact", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "Accept": "application/json"
            },
            body: JSON.stringify(data)
          });

          const result = await response.json();

          if (response.ok && result && result.success) {
            borboyonaForm.classList.add('hidden');
            if (borboyonaSuccessMsg) borboyonaSuccessMsg.classList.remove('hidden');
          } else {
            throw new Error(result.message || "Error al procesar la solicitud");
          }
        } catch (err) {
          console.warn("Contact endpoint notice:", err);
          const mailtoSubject = encodeURIComponent("[Sonde Capital - Borboyona] Solicitud de Data Room");
          const mailtoBody = encodeURIComponent(`Nombre: ${data.nombre || ''}\nEmpresa: ${data.empresa || ''}\nEmail: ${data.email || ''}\nInterés: ${data.interes_transaccional || ''}\nMensaje: ${data.mensaje || ''}`);
          const mailtoLink = document.getElementById('borboyona-error-mailto');
          if (mailtoLink) {
            mailtoLink.href = `mailto:miguel.ampuero333@gmail.com,miguel.ampuero@sondecapital.com?subject=${mailtoSubject}&body=${mailtoBody}`;
          }
          if (borboyonaErrorMsg) borboyonaErrorMsg.classList.remove('hidden');
          if (borboyonaSubmitBtn) borboyonaSubmitBtn.disabled = false;
          if (borboyonaBtnIcon) borboyonaBtnIcon.className = "fa-solid fa-lock text-amber-400 text-xs";
          if (borboyonaBtnText) borboyonaBtnText.textContent = "Reintentar Solicitud";
        }
      });
    }
  </script>

  <style>
    /* Kinetic Sequential Entrance Choreography (animation-systems & apple-design) */
    @keyframes heroReveal {
      from {
        opacity: 0;
        transform: translateY(24px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .hero-enter-badge {
      animation: heroReveal 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.05s both;
      will-change: transform, opacity;
    }

    /* Paso 1: El título aparece primero con resplandor */
    .hero-enter-title {
      animation: heroReveal 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.2s both;
      will-change: transform, opacity;
    }

    /* Paso 2: La descripción aparece después de que el título termina de revelarse */
    .hero-enter-desc {
      animation: heroReveal 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.85s both;
      will-change: transform, opacity;
    }

    /* Paso 3: Los CTAs aparecen después de que la descripción se asienta */
    .hero-enter-cta {
      animation: heroReveal 0.55s cubic-bezier(0.16, 1, 0.3, 1) 1.4s both;
      will-change: transform, opacity;
    }

    /* Paso 4: El carrusel de muestras entra suavemente al final */
    .hero-enter-carousel {
      animation: heroReveal 0.7s cubic-bezier(0.16, 1, 0.3, 1) 1.75s both;
      will-change: transform, opacity;
    }

    @media (prefers-reduced-motion: reduce) {
      .hero-enter-badge,
      .hero-enter-title,
      .hero-enter-desc,
      .hero-enter-cta,
      .hero-enter-carousel {
        animation: none !important;
        opacity: 1 !important;
        transform: none !important;
      }
    }
  </style>
</Layout>

