---
import '../../styles/global.css';
import PresentationViewer from '../../components/PresentationViewer.astro';
import FinancialChart from '../../components/FinancialChart.astro';

const slides = [
  { id: 'resumen', title: '1. Resumen Ejecutivo', badge: 'Visión General', category: 'Introducción' },
  { id: 'geologia', title: '2. Geología & Reservas', badge: 'Alta Ley', category: 'Técnico' },
  { id: 'financiero', title: '3. Modelo Financiero', badge: 'Retorno & Flujo', category: 'Finanzas' },
  { id: 'adquisicion', title: '4. Términos & Cierre', badge: 'Private Equity', category: 'Estructura' },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pitch Ejecutivo: Proyecto Polimetálico Borboyona | Sonde Capital</title>
    <link rel="icon" type="image/png" href="/assets/sonde_logo_transparent.png" />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
      integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
  </head>
  <body class="bg-slate-950 text-slate-100 font-sans antialiased overflow-hidden">
    <PresentationViewer
      projectTitle="Proyecto Polimetálico Borboyona"
      projectCode="BOR-2026"
      slides={slides}
      dossierPdfUrl="/assets/resumen-ejecutivo-borboyona (1).pdf"
    >
      <!-- SLIDE 1: RESUMEN EJECUTIVO -->
      <div class="slide-content-panel flex flex-col lg:flex-row gap-8 items-center bg-slate-900/90 border border-slate-800 rounded-3xl p-6 sm:p-10 backdrop-blur-xl shadow-2xl">
        <div class="w-full lg:w-1/2 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-extrabold uppercase tracking-widest bg-amber-500/20 text-amber-300 border border-amber-500/30">
            <i class="fa-solid fa-bolt text-amber-400"></i> Oportunidad de Inversión Estratégica
          </div>
          
          <h2 class="text-2xl sm:text-4xl font-extrabold text-white leading-tight">
            Depósito Polimetálico de Clase Mundial en Perú
          </h2>
          
          <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
            El <strong>Proyecto Borboyona</strong> representa un activo minero de alta ley con mineralización probada de <span class="text-amber-400 font-semibold">Cobre, Plata, Plomo y Zinc</span>. Ubicado en una de las franjas metalogénicas más prolíficas y con acceso logístico consolidado.
          </p>

          <div class="grid grid-cols-2 gap-4 pt-2">
            <div class="bg-slate-950/70 p-4 rounded-2xl border border-slate-800">
              <span class="text-xs text-slate-400 uppercase tracking-wider block font-semibold">Ubicación</span>
              <span class="text-base font-bold text-white flex items-center gap-1.5 mt-1">
                <i class="fa-solid fa-location-dot text-amber-500 text-xs"></i> Sierra Central, Perú
              </span>
            </div>
            <div class="bg-slate-950/70 p-4 rounded-2xl border border-slate-800">
              <span class="text-xs text-slate-400 uppercase tracking-wider block font-semibold">Acceso Logístico</span>
              <span class="text-base font-bold text-emerald-400 flex items-center gap-1.5 mt-1">
                <i class="fa-solid fa-road text-xs"></i> 100% Carretera Asfaltada
              </span>
            </div>
          </div>
        </div>

        <div class="w-full lg:w-1/2 relative rounded-2xl overflow-hidden border border-slate-800 aspect-video lg:aspect-auto h-72 sm:h-96 shadow-inner">
          <img
            src="/assets/Oro 6.jpg"
            alt="Mina Borboyona"
            class="w-full h-full object-cover"
            onerror="this.onerror=null; this.src='/assets/Fondo oro 2.jpg';"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent"></div>
          <div class="absolute bottom-4 left-4 right-4 bg-slate-950/85 backdrop-blur-md p-3.5 rounded-xl border border-slate-800">
            <p class="text-xs text-slate-300">
              <strong class="text-amber-400">Estado:</strong> Concesión titulada y lista para fase de perforación diamantina y expansión de recursos.
            </p>
          </div>
        </div>
      </div>

      <!-- SLIDE 2: GEOLOGÍA & RESERVAS -->
      <div class="slide-content-panel hidden flex-col lg:flex-row gap-8 items-center bg-slate-900/90 border border-slate-800 rounded-3xl p-6 sm:p-10 backdrop-blur-xl shadow-2xl">
        <div class="w-full lg:w-1/2 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-extrabold uppercase tracking-widest bg-blue-500/20 text-blue-300 border border-blue-500/30">
            <i class="fa-solid fa-microscope text-blue-400"></i> Rigor Técnico & Ensayos
          </div>
          
          <h2 class="text-2xl sm:text-4xl font-extrabold text-white leading-tight">
            Anomalías Geoquímicas y Calidad del Mineral
          </h2>
          
          <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
            Muestreos sistemáticos de canal y trincheras confirman continuidad en vetas epitermales y cuerpos de reemplazamiento metasomático con leyes sobresalientes por encima del promedio del mercado.
          </p>

          <div class="space-y-3">
            <div class="flex items-center justify-between p-3.5 bg-slate-950/70 rounded-xl border border-slate-800">
              <span class="text-xs font-bold text-slate-300">Plata (Ag)</span>
              <span class="text-sm font-bold text-amber-400 tabular-nums">Hasta 14.5 oz/TC</span>
            </div>
            <div class="flex items-center justify-between p-3.5 bg-slate-950/70 rounded-xl border border-slate-800">
              <span class="text-xs font-bold text-slate-300">Cobre (Cu)</span>
              <span class="text-sm font-bold text-amber-400 tabular-nums">2.8% - 4.2%</span>
            </div>
            <div class="flex items-center justify-between p-3.5 bg-slate-950/70 rounded-xl border border-slate-800">
              <span class="text-xs font-bold text-slate-300">Zinc & Plomo (Zn / Pb)</span>
              <span class="text-sm font-bold text-amber-400 tabular-nums">8.6% Combinado</span>
            </div>
          </div>
        </div>

        <div class="w-full lg:w-1/2 bg-slate-950/80 rounded-2xl p-6 border border-slate-800 space-y-4">
          <h4 class="text-xs uppercase tracking-wider text-slate-400 font-bold">Ventajas Metalúrgicas Clave</h4>
          
          <div class="space-y-3">
            <div class="flex gap-3 items-start">
              <div class="w-7 h-7 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0 text-xs font-bold">
                <i class="fa-solid fa-check"></i>
              </div>
              <p class="text-xs text-slate-300 leading-relaxed">
                <strong>Alta Recuperación Metalúrgica:</strong> Pruebas preliminares de flotación arrojan recuperaciones superiores al 88% en concentrados limpios.
              </p>
            </div>
            <div class="flex gap-3 items-start">
              <div class="w-7 h-7 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0 text-xs font-bold">
                <i class="fa-solid fa-check"></i>
              </div>
              <p class="text-xs text-slate-300 leading-relaxed">
                <strong>Bajo Nivel de Penalidades:</strong> Mineral limpio sin contenidos nocivos de arsénico o mercurio, óptimo para venta en refinerías locales.
              </p>
            </div>
            <div class="flex gap-3 items-start">
              <div class="w-7 h-7 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0 text-xs font-bold">
                <i class="fa-solid fa-check"></i>
              </div>
              <p class="text-xs text-slate-300 leading-relaxed">
                <strong>Potencial en Profundidad:</strong> Vetas abiertas en rumbo y profundidad con alto potencial de incremento en reservas 3P.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- SLIDE 3: MODELO FINANCIERO -->
      <div class="slide-content-panel hidden flex-col bg-slate-900/90 border border-slate-800 rounded-3xl p-6 sm:p-8 backdrop-blur-xl shadow-2xl space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-extrabold uppercase tracking-widest bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 mb-2">
              <i class="fa-solid fa-chart-line text-emerald-400"></i> Métricas Financieras Proyectadas
            </div>
            <h2 class="text-xl sm:text-3xl font-extrabold text-white">
              Retorno Proyectado y Estructura de Flujo
            </h2>
          </div>
          <div class="text-right sm:self-center">
            <span class="text-xs text-slate-400 block">TIR Proyectada Base</span>
            <span class="text-2xl sm:text-3xl font-extrabold text-emerald-400 tabular-nums">42.8%</span>
          </div>
        </div>

        <div class="bg-white rounded-2xl overflow-hidden text-slate-900">
          <FinancialChart chartId="slideFinancialChart" title="Proyección de Flujo Neto del Proyecto" subtitle="Estimación de retornos y amortización de capital" />
        </div>
      </div>

      <!-- SLIDE 4: TÉRMINOS & CIERRE -->
      <div class="slide-content-panel hidden flex-col lg:flex-row gap-8 items-center bg-slate-900/90 border border-slate-800 rounded-3xl p-6 sm:p-10 backdrop-blur-xl shadow-2xl">
        <div class="w-full lg:w-1/2 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-extrabold uppercase tracking-widest bg-amber-500/20 text-amber-300 border border-amber-500/30">
            <i class="fa-solid fa-handshake text-amber-400"></i> Estructura de Adquisición
          </div>
          
          <h2 class="text-2xl sm:text-4xl font-extrabold text-white leading-tight">
            Estructura de Capital y Mecanismo de Entrada
          </h2>
          
          <p class="text-sm text-slate-300 leading-relaxed">
            Sonde Capital ofrece una estructura flexible de asociación a través de aportes de capital escalonados, con salvaguardas legales, fideicomiso de desarrollo y prioridad en dividendos.
          </p>

          <div class="space-y-3">
            <div class="p-3.5 bg-slate-950/80 rounded-xl border border-slate-800 flex items-center justify-between">
              <span class="text-xs text-slate-400 font-semibold">Tickets de Inversión</span>
              <span class="text-sm font-bold text-white">$500k - $3.5M USD</span>
            </div>
            <div class="p-3.5 bg-slate-950/80 rounded-xl border border-slate-800 flex items-center justify-between">
              <span class="text-xs text-slate-400 font-semibold">Periodo de Bloqueo / Salida</span>
              <span class="text-sm font-bold text-white">Opción de recompra a partir del Mes 24</span>
            </div>
          </div>
        </div>

        <div class="w-full lg:w-1/2 bg-gradient-to-br from-slate-950 to-slate-900 p-6 sm:p-8 rounded-2xl border border-slate-800 text-center space-y-5">
          <div class="w-16 h-16 rounded-2xl bg-amber-500/10 text-amber-400 border border-amber-500/20 flex items-center justify-center mx-auto text-2xl">
            <i class="fa-solid fa-calendar-check"></i>
          </div>

          <h3 class="text-xl font-bold text-white">Solicitar Data Room & Due Diligence</h3>
          <p class="text-xs text-slate-300 leading-relaxed">
            Acceso completo a reportes de geofísica, títulos de propiedad inscritos en SUNARP y modelo financiero auditable en Excel.
          </p>

          <div class="pt-2 flex flex-col gap-3">
            <a
              href="mailto:inversiones@sondecapital.com?subject=Solicitud%20Data%20Room%20Borboyona"
              class="w-full py-3 px-6 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-700 text-slate-950 font-bold text-sm transition-all shadow-md active:scale-95"
            >
              Contactar al Directorio de Inversión
            </a>
            <a
              href="/assets/resumen-ejecutivo-borboyona (1).pdf"
              download
              class="w-full py-3 px-6 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-semibold text-xs transition-all border border-slate-700"
            >
              Descargar Resumen Ejecutivo (PDF)
            </a>
          </div>
        </div>
      </div>
    </PresentationViewer>
  </body>
</html>
