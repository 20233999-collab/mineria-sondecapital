<script is:inline src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    const commonOptions = {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          position: 'top',
          labels: {
            font: { family: "'Inter', sans-serif", size: 12 },
            color: '#334155',
            usePointStyle: true,
            padding: 15
          }
        },
        tooltip: {
          backgroundColor: '#0F172A',
          titleFont: { family: "'Plus Jakarta Sans', sans-serif", size: 13 },
          bodyFont: { family: "'Inter', sans-serif", size: 12 },
          padding: 12,
          cornerRadius: 8,
          displayColors: true,
        }
      },
      scales: {
        y: {
          grid: { color: 'rgba(15, 23, 42, 0.06)' },
          ticks: { font: { family: "'Inter', sans-serif" }, color: '#64748B' }
        },
        x: {
          grid: { display: false },
          ticks: { font: { family: "'Inter', sans-serif" }, color: '#64748B' }
        }
      }
    };

    // 1. Financial Chart
    const canvasFinancial = document.getElementById('adrianoFinancialChart');
    if (canvasFinancial) {
      const ctxFinancial = canvasFinancial.getContext('2d');
      const gradientGold = ctxFinancial.createLinearGradient(0, 0, 0, 320);
      gradientGold.addColorStop(0, 'rgba(217, 119, 6, 0.25)');
      gradientGold.addColorStop(1, 'rgba(217, 119, 6, 0)');

      const gradientTeal = ctxFinancial.createLinearGradient(0, 0, 0, 320);
      gradientTeal.addColorStop(0, 'rgba(13, 148, 136, 0.25)');
      gradientTeal.addColorStop(1, 'rgba(13, 148, 136, 0)');

      new Chart(ctxFinancial, {
        type: 'line',
        data: {
          labels: ['Año 1', 'Año 2', 'Año 3', 'Año 4', 'Año 5', 'Año 7', 'Año 10'],
          datasets: [
            {
              label: 'Ingresos Proyectados (Caso Base)',
              data: [350, 420, 580, 850, 1100, 1400, 2000],
              borderColor: '#D97706',
              backgroundColor: gradientGold,
              borderWidth: 2.5,
              tension: 0.35,
              fill: true,
              pointBackgroundColor: '#FFFFFF',
              pointBorderColor: '#D97706',
              pointRadius: 4,
              pointHoverRadius: 6
            },
            {
              label: 'EBITDA Proyectado (Caso Base)',
              data: [156, 190, 270, 400, 550, 700, 1000],
              borderColor: '#0D9488',
              backgroundColor: gradientTeal,
              borderWidth: 2.5,
              tension: 0.35,
              fill: true,
              pointBackgroundColor: '#FFFFFF',
              pointBorderColor: '#0D9488',
              pointRadius: 4,
              pointHoverRadius: 6
            }
          ]
        },
        options: {
          ...commonOptions,
          plugins: {
            ...commonOptions.plugins,
            tooltip: {
              ...commonOptions.plugins.tooltip,
              callbacks: {
                label: function (context) {
                  let label = context.dataset.label || '';
                  if (label) label += ': ';
                  if (context.parsed.y !== null) {
                    label += '$' + context.parsed.y + 'M USD';
                  }
                  return label;
                }
              }
            }
          }
        }
      });
    }

    // 2. Reserve Scale Chart
    const canvasReserve = document.getElementById('adrianoReserveChart');
    if (canvasReserve) {
      const ctxReserve = canvasReserve.getContext('2d');
      new Chart(ctxReserve, {
        type: 'bar',
        data: {
          labels: ['Sonde Adriano (PER)', 'Serra Verde (BRA)', 'Mountain Pass (USA)', 'Mount Weld (AUS)'],
          datasets: [
            {
              label: 'Diversidad de Elementos',
              data: [41, 3, 4, 4],
              backgroundColor: ['#0F172A', '#94A3B8', '#94A3B8', '#94A3B8'],
              borderRadius: 6,
              borderSkipped: false
            }
          ]
        },
        options: {
          ...commonOptions,
          plugins: {
            ...commonOptions.plugins,
            legend: { display: false },
            tooltip: {
              ...commonOptions.plugins.tooltip,
              callbacks: {
                title: function (context) {
                  return context[0].label;
                },
                label: function (context) {
                  if (context.dataIndex === 0) return '41 Elementos (15 REE + 23 Metales Estratégicos)';
                  if (context.dataIndex === 1) return '2-3 Elementos (Nd, Pr foco)';
                  return 'Foco limitado a tierras raras base';
                }
              }
            }
          },
          scales: {
            y: {
              ...commonOptions.scales.y,
              title: {
                display: true,
                text: 'Diversidad de Elementos Confirmados',
                font: { family: "'Inter', sans-serif" }
              }
            }
          }
        }
      });
    }
  });
</script>
