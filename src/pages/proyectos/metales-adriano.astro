---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Metales Estratégicos & Tierras Raras Adriano | Sonde Capital"
  description="Oportunidad de inversión institucional en formación ofiolítica de origen mantélico en el norte de Perú. 41 elementos estratégicos y tierras raras."
>
  <!-- Hero Section -->
  <section id="overview" class="pt-16 pb-20 lg:pt-24 lg:pb-28 relative overflow-hidden bg-slate-50 border-b border-slate-200/80">
    <!-- Background Grid Pattern -->
    <div
      class="absolute inset-0 opacity-[0.03] pointer-events-none"
      style="background-image: radial-gradient(#0F172A 1px, transparent 1px); background-size: 32px 32px;"
    ></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center max-w-4xl mx-auto">
        <!-- Confidentiality Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-950 text-white text-xs font-semibold tracking-wider uppercase mb-6 shadow-sm">
          <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
          Estrictamente Confidencial · Solo Inversionistas Calificados
        </div>

        <!-- Big Title requested by User in Spanish -->
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-slate-950 leading-tight mb-4 tracking-tight">
          Metales Estratégicos & Tierras Raras Adriano
        </h1>
        
        <p class="text-xl sm:text-2xl font-bold text-amber-600 mb-6">
          El Activo Mineral Estratégico Más Importante de la Década
        </p>

        <p class="text-base sm:text-lg text-slate-600 mb-10 max-w-3xl mx-auto leading-relaxed">
          Oportunidad de inversión exclusiva en una formación ofiolítica de origen mantélico en el norte de Perú. <strong class="text-slate-900">41 elementos estratégicos</strong> y tierras raras con potencial geológico de escala mundial.
        </p>

        <div class="flex flex-col sm:flex-row justify-center items-center gap-4">
          <a
            href="#dashboard"
            class="w-full sm:w-auto bg-slate-900 hover:bg-slate-950 text-white font-semibold rounded-xl px-8 py-4 transition-all hover:-translate-y-0.5 shadow-md flex items-center justify-center gap-2"
          >
            <i class="fa-solid fa-chart-line text-amber-400"></i>
            <span>Ver Proyecciones Financieras</span>
          </a>
          <a
            href="#technical"
            class="w-full sm:w-auto bg-white border border-slate-300 hover:bg-slate-100 text-slate-900 font-semibold rounded-xl px-8 py-4 transition-all flex items-center justify-center gap-2 shadow-xs"
          >
            <i class="fa-solid fa-microscope text-slate-600"></i>
            <span>Explorar Ficha Técnica</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- KPI Cards Section -->
  <section class="py-12 bg-white border-b border-slate-200 relative z-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 -mt-20">
        <!-- KPI 1 -->
        <div class="bg-white rounded-2xl p-6 shadow-xl border-t-4 border-amber-500 flex flex-col justify-between h-full transform transition duration-300 hover:-translate-y-1 border border-slate-200">
          <div>
            <p class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Valoración Base (USD)</p>
            <h3 class="text-3xl font-extrabold text-slate-950 tabular-nums">$2.75 B+</h3>
          </div>
          <div class="mt-4 flex items-center text-xs text-teal-600 font-semibold">
            <i class="fa-solid fa-arrow-trend-up mr-1.5"></i>
            Precio de Salida Institucional
          </div>
        </div>

        <!-- KPI 2 -->
        <div class="bg-white rounded-2xl p-6 shadow-xl border-t-4 border-slate-800 flex flex-col justify-between h-full transform transition duration-300 hover:-translate-y-1 border border-slate-200">
          <div>
            <p class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Elementos Confirmados</p>
            <h3 class="text-3xl font-extrabold text-slate-950 tabular-nums">41</h3>
          </div>
          <div class="mt-4 flex items-center text-xs text-slate-700">
            <span class="inline-block w-2 h-2 rounded-full bg-amber-500 mr-2"></span>
            15 REE + 23 Metales Estratégicos
          </div>
        </div>

        <!-- KPI 3 -->
        <div class="bg-white rounded-2xl p-6 shadow-xl border-t-4 border-slate-800 flex flex-col justify-between h-full transform transition duration-300 hover:-translate-y-1 border border-slate-200">
          <div>
            <p class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Escala de Concesión</p>
            <h3 class="text-3xl font-extrabold text-slate-950 tabular-nums">2,328<span class="text-lg text-slate-500 ml-1">ha</span></h3>
          </div>
          <div class="mt-4 flex items-center text-xs text-slate-700">
            <span class="inline-block px-2 py-0.5 rounded bg-slate-100 border border-slate-200 mr-2 font-bold text-[11px]">100%</span>
            Accesibilidad Open-Pit (Tajo Abierto)
          </div>
        </div>

        <!-- KPI 4 -->
        <div class="bg-white rounded-2xl p-6 shadow-xl border-t-4 border-teal-500 flex flex-col justify-between h-full transform transition duration-300 hover:-translate-y-1 border border-slate-200">
          <div>
            <p class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Validación Técnica</p>
            <h3 class="text-3xl font-extrabold text-slate-950 tabular-nums">15</h3>
          </div>
          <div class="mt-4 flex items-center text-xs text-slate-700">
            <i class="fa-solid fa-circle-check mr-1.5 text-teal-600"></i>
            Estudios Independientes (2004-2022)
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Dashboard Section -->
  <section id="dashboard" class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-12 flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div class="max-w-2xl">
          <span class="text-xs uppercase font-extrabold tracking-widest text-amber-600 block mb-1">Modelo de Valoración</span>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-950 mb-3">Dashboard de Retorno & Proyecciones</h2>
          <p class="text-slate-600 text-sm sm:text-base">
            Análisis basado en economía estándar de minería a tajo abierto, precios de mercado (Q1 2026) y supuestos de extracción conservadores aplicados exclusivamente a la zona evaluada de 300 hectáreas (13% del total).
          </p>
        </div>
        <div class="shrink-0">
          <span class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white border border-slate-200 text-xs font-bold text-slate-800 shadow-xs">
            <span class="w-2.5 h-2.5 rounded-full bg-teal-500"></span>
            Datos Geoquímicos Certificados
          </span>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Financial Projection Chart -->
        <div class="bg-white p-6 sm:p-8 rounded-2xl shadow-xs border border-slate-200">
          <div class="flex items-center justify-between mb-6 pb-2 border-b border-slate-100">
            <h3 class="text-base font-bold text-slate-900">Proyección Financiera (Años 1-10)</h3>
            <span class="text-xs text-slate-500 font-semibold">USD Millones</span>
          </div>
          <div class="relative h-80 w-full">
            <canvas id="adrianoFinancialChart"></canvas>
          </div>
        </div>

        <!-- Reserve Scale Comparison Chart -->
        <div class="bg-white p-6 sm:p-8 rounded-2xl shadow-xs border border-slate-200">
          <div class="flex items-center justify-between mb-6 pb-2 border-b border-slate-100">
            <h3 class="text-base font-bold text-slate-900">Escala de Reservas vs. Top Global</h3>
            <span class="text-xs text-slate-500 font-semibold">Diversidad de Elementos</span>
          </div>
          <div class="relative h-80 w-full flex items-center justify-center">
            <canvas id="adrianoReserveChart"></canvas>
          </div>
        </div>
      </div>

      <!-- Financial Data Table -->
      <div class="mt-8 bg-white rounded-2xl shadow-xs border border-slate-200 overflow-hidden">
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-slate-200 text-left">
            <thead class="bg-slate-100">
              <tr>
                <th scope="col" class="px-6 py-4 text-xs font-bold text-slate-700 uppercase tracking-wider">Métrica (Año 1)</th>
                <th scope="col" class="px-6 py-4 text-xs font-bold text-slate-700 uppercase tracking-wider tabular-nums">Estimación Conservadora</th>
                <th scope="col" class="px-6 py-4 text-xs font-bold text-slate-950 uppercase tracking-wider tabular-nums border-b-2 border-amber-500 bg-white">Caso Base</th>
                <th scope="col" class="px-6 py-4 text-xs font-bold text-slate-700 uppercase tracking-wider tabular-nums">Caso Optimista</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 bg-white text-sm">
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="px-6 py-4 font-semibold text-slate-900">Producción de Mineral (MT/año)</td>
                <td class="px-6 py-4 text-slate-600 tabular-nums">500,000</td>
                <td class="px-6 py-4 font-bold text-slate-950 tabular-nums bg-slate-50/70">1,000,000</td>
                <td class="px-6 py-4 text-slate-600 tabular-nums">2,000,000</td>
              </tr>
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="px-6 py-4 font-semibold text-slate-900">Concentrado REE (MT TREO)</td>
                <td class="px-6 py-4 text-slate-600 tabular-nums">4,000</td>
                <td class="px-6 py-4 font-bold text-slate-950 tabular-nums bg-slate-50/70">10,000</td>
                <td class="px-6 py-4 text-slate-600 tabular-nums">24,000</td>
              </tr>
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="px-6 py-4 font-semibold text-slate-900">Ingreso Bruto (USD)</td>
                <td class="px-6 py-4 text-slate-600 tabular-nums">$100M</td>
                <td class="px-6 py-4 font-extrabold text-amber-600 tabular-nums bg-slate-50/70">$350M</td>
                <td class="px-6 py-4 text-slate-600 tabular-nums">$1.2B</td>
              </tr>
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="px-6 py-4 font-semibold text-slate-900">EBITDA Estimado (USD)</td>
                <td class="px-6 py-4 text-slate-600 tabular-nums">$40–50M</td>
                <td class="px-6 py-4 font-bold text-slate-950 tabular-nums bg-slate-50/70">$156–210M</td>
                <td class="px-6 py-4 text-slate-600 tabular-nums">$585–715M</td>
              </tr>
              <tr class="bg-slate-950 text-white font-semibold">
                <td class="px-6 py-4 text-amber-300">NPV 10-Años (8% descuento)</td>
                <td class="px-6 py-4 tabular-nums text-slate-300">$800M – $1.2B</td>
                <td class="px-6 py-4 font-extrabold text-amber-400 tabular-nums border-b-2 border-amber-500 bg-slate-900">$2.0B – $3.5B</td>
                <td class="px-6 py-4 tabular-nums text-slate-300">$5B – $8B+</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- Technical Sheet Section -->
  <section id="technical" class="py-20 bg-white border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        <!-- Left Column: Context -->
        <div class="lg:col-span-4 space-y-6">
          <span class="text-xs uppercase font-extrabold tracking-widest text-amber-600 block">
            Geología y Concesiones
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-950">Ficha Técnica & Yacimiento</h2>
          <p class="text-slate-600 text-sm leading-relaxed">
            El depósito comprende cinco concesiones tituladas (Atahualpa, Bonanza, Gasñape, Huascar, Incanato) en La Libertad, Perú. La formación es un cuerpo intrusivo de gabro emplazado dentro de rocas basálticas del Jurásico Superior.
          </p>

          <div class="bg-slate-50 p-6 rounded-2xl border border-slate-200">
            <h4 class="font-bold text-slate-900 mb-2 flex items-center gap-2 text-sm">
              <i class="fa-solid fa-crown text-amber-500"></i>
              Ventaja Competitiva Única
            </h4>
            <p class="text-xs text-slate-600 leading-relaxed">
              Lo que distingue a este yacimiento es su <strong>origen ofiolítico</strong> (roca formada en el límite del manto terrestre). Los minerales están diseminados en la superficie, permitiendo una extracción <strong>100% a tajo abierto (open-pit)</strong> a solo 75km del Puerto de Salaverry.
            </p>
          </div>

          <ul class="space-y-3 pt-2">
            <li class="flex items-start gap-3 bg-slate-50 p-3 rounded-xl border border-slate-100">
              <div class="w-6 h-6 rounded-full bg-amber-500/10 text-amber-600 flex items-center justify-center shrink-0 mt-0.5 text-xs font-bold">
                <i class="fa-solid fa-arrows-left-right"></i>
              </div>
              <div>
                <h5 class="text-xs font-bold text-slate-900">Diámetro de Estructura</h5>
                <p class="text-xs text-slate-600">~20 kilómetros de extensión continua.</p>
              </div>
            </li>
            <li class="flex items-start gap-3 bg-slate-50 p-3 rounded-xl border border-slate-100">
              <div class="w-6 h-6 rounded-full bg-slate-900 text-white flex items-center justify-center shrink-0 mt-0.5 text-xs font-bold">
                <i class="fa-solid fa-arrow-down"></i>
              </div>
              <div>
                <h5 class="text-xs font-bold text-slate-900">Profundidad Evaluada</h5>
                <p class="text-xs text-slate-600">200-300 metros (potencial &gt;1,000m en profundidad).</p>
              </div>
            </li>
          </ul>
        </div>

        <!-- Right Column: Elements Table -->
        <div class="lg:col-span-8">
          <div class="bg-white rounded-2xl shadow-xs border border-slate-200 overflow-hidden">
            <div class="px-6 py-5 border-b border-slate-200 bg-slate-50 flex justify-between items-center">
              <h3 class="font-bold text-slate-900 text-sm sm:text-base">Perfil Elemental Estratégico (Destacados)</h3>
              <span class="text-xs font-bold text-slate-700 bg-white px-3 py-1 rounded-full border border-slate-200 shadow-2xs">
                41 Elementos Totales
              </span>
            </div>
            <div class="overflow-x-auto">
              <table class="min-w-full divide-y divide-slate-200 text-left">
                <thead class="bg-slate-100">
                  <tr>
                    <th scope="col" class="px-6 py-3.5 text-xs font-bold text-slate-700 uppercase tracking-wider">Elemento</th>
                    <th scope="col" class="px-6 py-3.5 text-xs font-bold text-slate-700 uppercase tracking-wider">Símbolo</th>
                    <th scope="col" class="px-6 py-3.5 text-xs font-bold text-slate-700 uppercase tracking-wider tabular-nums">Concentración (PPM)</th>
                    <th scope="col" class="px-6 py-3.5 text-xs font-bold text-slate-700 uppercase tracking-wider">Prioridad Geopolítica</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 bg-white text-sm">
                  <tr class="hover:bg-slate-50 transition-colors">
                    <td class="px-6 py-3.5 font-bold text-slate-900">Rubidio</td>
                    <td class="px-6 py-3.5 text-slate-600 font-semibold">Rb</td>
                    <td class="px-6 py-3.5 text-slate-700 tabular-nums">150 - 479</td>
                    <td class="px-6 py-3.5"><span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-red-100 text-red-800 border border-red-200">EXTREMA</span></td>
                  </tr>
                  <tr class="hover:bg-slate-50 transition-colors">
                    <td class="px-6 py-3.5 font-bold text-slate-900">Neodimio (REE)</td>
                    <td class="px-6 py-3.5 text-slate-600 font-semibold">Nd*</td>
                    <td class="px-6 py-3.5 text-slate-700 tabular-nums">42.5</td>
                    <td class="px-6 py-3.5"><span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-red-100 text-red-800 border border-red-200">EXTREMA</span></td>
                  </tr>
                  <tr class="hover:bg-slate-50 transition-colors">
                    <td class="px-6 py-3.5 font-bold text-slate-900">Disprosio (REE)</td>
                    <td class="px-6 py-3.5 text-slate-600 font-semibold">Dy*</td>
                    <td class="px-6 py-3.5 text-slate-700 tabular-nums">638 - 786.2</td>
                    <td class="px-6 py-3.5"><span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-red-100 text-red-800 border border-red-200">EXTREMA</span></td>
                  </tr>
                  <tr class="hover:bg-slate-50 transition-colors">
                    <td class="px-6 py-3.5 font-bold text-slate-900">Cerio (REE)</td>
                    <td class="px-6 py-3.5 text-slate-600 font-semibold">Ce*</td>
                    <td class="px-6 py-3.5 text-slate-700 tabular-nums">117 - 150</td>
                    <td class="px-6 py-3.5"><span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-100 text-amber-800 border border-amber-200">CRÍTICA</span></td>
                  </tr>
                  <tr class="hover:bg-slate-50 transition-colors">
                    <td class="px-6 py-3.5 font-bold text-slate-900">Litio</td>
                    <td class="px-6 py-3.5 text-slate-600 font-semibold">Li</td>
                    <td class="px-6 py-3.5 text-slate-700 tabular-nums">221 - 513</td>
                    <td class="px-6 py-3.5"><span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-100 text-amber-800 border border-amber-200">CRÍTICA</span></td>
                  </tr>
                  <tr class="hover:bg-slate-50 transition-colors">
                    <td class="px-6 py-3.5 font-bold text-slate-900">Escandio (REE)</td>
                    <td class="px-6 py-3.5 text-slate-600 font-semibold">Sc*</td>
                    <td class="px-6 py-3.5 text-slate-700 tabular-nums">88.18 - 282.0</td>
                    <td class="px-6 py-3.5"><span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-100 text-blue-800 border border-blue-200">ALTA</span></td>
                  </tr>
                </tbody>
              </table>
            </div>
            <div class="px-6 py-4 bg-slate-50 border-t border-slate-200 text-xs text-slate-500">
              * REE (Elementos de Tierras Raras). La concentración de Rubidio sitúa a este depósito entre los registros más altos a nivel global.
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Structure of Participation Section -->
  <section id="structure" class="py-20 bg-slate-950 text-white relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-xs uppercase font-extrabold tracking-widest text-amber-400 block mb-2">
          Modelos de Inversión
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold mb-4">Estructura de Participación</h2>
        <p class="text-slate-300 text-sm sm:text-base">
          Modelos de colaboración estructurados exclusivamente para actores institucionales soberanos, fondos de capital privado y operadores mineros Tier-1.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Option 1 -->
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-8 hover:border-amber-500 transition-colors flex flex-col">
          <div class="w-12 h-12 bg-slate-800 rounded-xl flex items-center justify-center mb-6 text-amber-400 text-xl">
            <i class="fa-solid fa-building-columns"></i>
          </div>
          <h3 class="text-xl font-bold mb-2 text-white">Adquisición Total</h3>
          <p class="text-amber-400 font-bold text-sm mb-4">USD $2.75 B+</p>
          <p class="text-slate-300 text-sm mb-8 flex-grow leading-relaxed">
            Compra directa de las 5 concesiones, data geológica, estudios y derechos de acceso. 100% de control sobre un activo crítico para la cadena de suministro global.
          </p>
          <div class="text-xs text-slate-400 uppercase tracking-wider font-bold pt-4 border-t border-slate-800">
            Ideal para: Fondos Soberanos, Gobiernos
          </div>
        </div>

        <!-- Option 2 -->
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-8 hover:border-amber-500 transition-colors flex flex-col relative overflow-hidden">
          <div class="absolute top-0 right-0 bg-amber-500 text-slate-950 text-[10px] font-extrabold px-3 py-1 uppercase tracking-widest rounded-bl-xl">
            Recomendado
          </div>
          <div class="w-12 h-12 bg-slate-800 rounded-xl flex items-center justify-center mb-6 text-amber-400 text-xl">
            <i class="fa-solid fa-handshake"></i>
          </div>
          <h3 class="text-xl font-bold mb-2 text-white">Joint Venture (Operador)</h3>
          <p class="text-amber-400 font-bold text-sm mb-4">Revenue Share Negociado</p>
          <p class="text-slate-300 text-sm mb-8 flex-grow leading-relaxed">
            El operador aporta capital y capacidad de extracción a cambio de una participación en los ingresos o equity. Estructurado y guiado por Sonde Capital.
          </p>
          <div class="text-xs text-slate-400 uppercase tracking-wider font-bold pt-4 border-t border-slate-800">
            Ideal para: Mineras Mid-size, PE Funds
          </div>
        </div>

        <!-- Option 3 -->
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-8 hover:border-amber-500 transition-colors flex flex-col">
          <div class="w-12 h-12 bg-slate-800 rounded-xl flex items-center justify-center mb-6 text-amber-400 text-xl">
            <i class="fa-solid fa-truck-ramp-box"></i>
          </div>
          <h3 class="text-xl font-bold mb-2 text-white">Suministro Raw (EXW)</h3>
          <p class="text-amber-400 font-bold text-sm mb-4">Acuerdo Offtake</p>
          <p class="text-slate-300 text-sm mb-8 flex-grow leading-relaxed">
            Suministro directo de mineral triturado base Ex Works a procesadores calificados. La vía más rápida a ingresos comerciales sin adquisición total.
          </p>
