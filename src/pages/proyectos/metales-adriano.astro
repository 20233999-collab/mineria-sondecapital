---
// Página Principal de Rediseño: Metales Estratégicos & Tierras Raras Adriano
// Dominio: adriano.sondecapital.com (enrutado vía vercel.json)
import Layout from '../../layouts/Layout.astro';
import AdrianoNavbar from '../../components/adriano/AdrianoNavbar.astro';
import AdrianoHero from '../../components/adriano/AdrianoHero.astro';
import AdrianoScaleRibbon from '../../components/adriano/AdrianoScaleRibbon.astro';
import AdrianoGeopolitics from '../../components/adriano/AdrianoGeopolitics.astro';
import AdrianoBenchmarking from '../../components/adriano/AdrianoBenchmarking.astro';
import AdrianoElementsMatrix from '../../components/adriano/AdrianoElementsMatrix.astro';
import AdrianoGeologyLogistics from '../../components/adriano/AdrianoGeologyLogistics.astro';
import AdrianoFieldGallery from '../../components/adriano/AdrianoFieldGallery.astro';
import AdrianoEngagement from '../../components/adriano/AdrianoEngagement.astro';
import AdrianoDataRoomContact from '../../components/adriano/AdrianoDataRoomContact.astro';
---

<Layout
  title="Metales Estratégicos & Tierras Raras Adriano | Sonde Capital"
  description="Oportunidad de inversión institucional en formación ofiolítica mantélica en el norte de Perú. 41 elementos confirmados por 15 estudios certificados (ACTLABS, ALS, SGS). 100% tajo abierto y 75 km a Salaverry."
  hideHeader={true}
  hideFooter={true}
>
  <!-- 1. Header Slim con navegación compacta y botón de solicitar NDA -->
  <AdrianoNavbar />

  <main class="overflow-hidden">
    <!-- 2. Hero Institucional con fotografía real de portada y titulares oficiales -->
    <AdrianoHero />

    <!-- 3. Cinta Bento Grid de Escala & Métricas Duras Verificadas (Sin Proyecciones) -->
    <AdrianoScaleRibbon />

    <!-- 4. Contexto Geopolítico & Seguridad de la Cadena de Suministro Occidental -->
    <AdrianoGeopolitics />

    <!-- 5. Benchmarking Global frente a Serra Verde (Brasil), Mountain Pass y Mount Weld -->
    <AdrianoBenchmarking />

    <!-- 6. Matriz Interactiva de los 41 Elementos y Tierras Raras con Buscador y Filtros -->
    <AdrianoElementsMatrix />

    <!-- 7. Ficha Geológica de las 05 Concesiones & Corredor Portuario a Salaverry -->
    <AdrianoGeologyLogistics />

    <!-- 8. Galería Fotográfica de Terreno, Maquinaria Pesada & Encuentro Diplomático -->
    <AdrianoFieldGallery />

    <!-- 9. Vías de Inversión (Adquisición, JV y Offtake) & Cronograma de Due Diligence -->
    <AdrianoEngagement />

    <!-- 10. Data Room Confidencial, Solicitud de NDA y Footer Institucional -->
    <AdrianoDataRoomContact />
  </main>
</Layout>

<style is:global>
  /* =========================================================================
     ANIMACIONES ON SCROLL (Skill: animation-on-scroll & animation-systems)
     ========================================================================= */
  [data-animate="fade-up"] {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.75s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.75s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform;
  }

  [data-animate="fade-up"].in-view {
    opacity: 1;
    transform: translateY(0);
  }

  /* Suavizado de desplazamiento */
  html {
    scroll-behavior: smooth;
    scroll-padding-top: 5rem;
  }

  /* Números tabulares para alineación contable perfecta en datos técnicos */
  .tabular-nums {
    font-feature-settings: "tnum" 1, "cv05" 1;
  }
</style>

<script is:inline>
  // Script de Inicialización de Animaciones on-scroll
  document.addEventListener('DOMContentLoaded', () => {
    const animatedElements = document.querySelectorAll('[data-animate]');

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries, obs) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const el = entry.target;
            const delay = el.getAttribute('data-delay') || '0';
            
            setTimeout(() => {
              el.classList.add('in-view');
            }, parseInt(delay, 10));

            obs.unobserve(el);
          }
        });
      }, {
        root: null,
        rootMargin: '0px 0px -50px 0px',
        threshold: 0.08
      });

      animatedElements.forEach(el => observer.observe(el));
    } else {
      // Fallback si IntersectionObserver no está soportado
      animatedElements.forEach(el => el.classList.add('in-view'));
    }
  });
</script>
